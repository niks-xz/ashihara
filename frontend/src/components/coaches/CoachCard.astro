---
import type { CollectionEntry } from 'astro:content';
import Card from '../ui/Card.astro';

interface Props {
  coach: CollectionEntry<'coaches'>;
}

const { coach } = Astro.props;
const bioPreview = coach.body?.replace(/\s+/g, ' ').trim();
---

<Card href={`/coaches/${coach.id}`} class="h-full group">
  <div class="p-6 text-center">
    <div class="w-28 h-28 mx-auto mb-4 rounded-full overflow-hidden bg-neutral-100">
      <div class="w-full h-full flex items-center justify-center">
        <svg class="w-14 h-14 text-neutral-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0" />
        </svg>
      </div>
    </div>
    <h3 class="text-lg font-bold text-dark group-hover:text-primary transition-colors">{coach.data.fullName}</h3>
    {coach.data.rank && <p class="text-primary font-medium text-sm mt-1">{coach.data.rank}</p>}
    {coach.data.title && <p class="text-neutral-600 text-sm mt-1">{coach.data.title}</p>}
    {bioPreview && <div class="text-neutral-700 text-sm mt-3 line-clamp-3">{bioPreview}</div>}
    <div class="mt-5 text-sm font-semibold text-primary">
      Подробнее &rarr;
    </div>
  </div>
</Card>
