---
import Card from '../ui/Card.astro';
import { withBase } from '../../lib/utils';
import type { Coach } from '../../lib/types';

interface Props {
  coach: Coach;
}

const { coach } = Astro.props;
const coachHref = coach.slug ? `/coaches/${coach.slug}` : undefined;
---

<Card href={coachHref} class="h-full group">
  <div class="p-6 text-center">
    <div class="w-28 h-28 mx-auto mb-4 rounded-full overflow-hidden bg-neutral-100">
      {coach.photo ? (
        <img
          src={withBase(coach.photo.url)}
          alt={coach.fullName}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center">
          <svg class="w-14 h-14 text-neutral-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0" />
          </svg>
        </div>
      )}
    </div>
    <h3 class="text-lg font-bold text-dark group-hover:text-primary transition-colors">{coach.fullName}</h3>
    {coach.rank && <p class="text-primary font-medium text-sm mt-1">{coach.rank}</p>}
    {coach.title && <p class="text-neutral-600 text-sm mt-1">{coach.title}</p>}
    {coach.bio && <div class="text-neutral-700 text-sm mt-3 line-clamp-3" set:html={coach.bio.replace(/<[^>]+>/g, ' ').trim()} />}
    {coach.gyms && coach.gyms.length > 0 && (
      <div class="mt-3 flex flex-wrap justify-center gap-1.5">
        {coach.gyms.map((gym) => (
          <span class="text-xs bg-neutral-100 text-neutral-600 px-2 py-1 rounded">{gym.name}</span>
        ))}
      </div>
    )}
    {coachHref && (
      <div class="mt-5 text-sm font-semibold text-primary">
        Подробнее &rarr;
      </div>
    )}
  </div>
</Card>
