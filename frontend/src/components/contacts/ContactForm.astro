---
interface Props {
  formType?: 'enrollment' | 'contact' | 'team-building';
}

const { formType = 'enrollment' } = Astro.props;
---

<form id="contact-form" class="space-y-5" novalidate>
  <input type="hidden" name="formType" value={formType} />
  <!-- Honeypot -->
  <div class="sr-only" aria-hidden="true">
    <input type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <input type="hidden" id="preferredGym" name="preferredGym" value="" />

  <div id="selected-gym-note" class="hidden rounded-lg border border-primary/20 bg-primary/5 p-4">
    <div class="text-xs font-semibold uppercase tracking-wide text-primary">Выбран зал</div>
    <div id="selected-gym-name" class="mt-1 font-semibold text-dark"></div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <label for="name" class="block text-sm font-medium text-neutral-700 mb-1.5">
        Имя <span class="text-primary">*</span>
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        class="w-full px-4 py-3 border border-neutral-300 rounded-lg text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-primary focus:shadow-[0_0_0_1px_theme(colors.primary)] transition-colors"
        placeholder="Ваше имя"
      />
    </div>
    <div>
      <label for="phone" class="block text-sm font-medium text-neutral-700 mb-1.5">
        Телефон <span class="text-primary">*</span>
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        required
        class="w-full px-4 py-3 border border-neutral-300 rounded-lg text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-primary focus:shadow-[0_0_0_1px_theme(colors.primary)] transition-colors"
        placeholder="+7 (___) ___-__-__"
      />
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <label for="email" class="block text-sm font-medium text-neutral-700 mb-1.5">
        Email
      </label>
      <input
        type="email"
        id="email"
        name="email"
        class="w-full px-4 py-3 border border-neutral-300 rounded-lg text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-primary focus:shadow-[0_0_0_1px_theme(colors.primary)] transition-colors"
        placeholder="email@example.com"
      />
    </div>
    <div>
      <label for="childAge" class="block text-sm font-medium text-neutral-700 mb-1.5">
        Возраст ребёнка
      </label>
      <input
        type="text"
        id="childAge"
        name="childAge"
        class="w-full px-4 py-3 border border-neutral-300 rounded-lg text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-primary focus:shadow-[0_0_0_1px_theme(colors.primary)] transition-colors"
        placeholder="Если записываете ребёнка"
      />
    </div>
  </div>

  <div>
    <label for="message" class="block text-sm font-medium text-neutral-700 mb-1.5">
      Сообщение
    </label>
    <textarea
      id="message"
      name="message"
      rows="4"
      class="w-full px-4 py-3 border border-neutral-300 rounded-lg text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-primary focus:shadow-[0_0_0_1px_theme(colors.primary)] transition-colors resize-y"
      placeholder="Дополнительная информация или вопросы"
    ></textarea>
  </div>

  <p class="text-sm text-neutral-600">
    После заполнения откроется письмо на email федерации. Если почта не откроется, можно сразу позвонить по телефону на странице.
  </p>

  <button
    type="submit"
    class="w-full sm:w-auto px-8 py-3 bg-primary text-white font-semibold rounded-lg hover:bg-primary-dark transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
  >
    Подготовить письмо
  </button>

  <div id="form-status" class="hidden rounded-lg p-4 text-sm font-medium" role="alert"></div>
</form>

<script is:inline>
  const gymNames = {
    'sk-olimp': 'СК «Олимп»',
    'dyussh-1': 'ДЮСШ №1',
    'sk-vityaz': 'СК «Витязь»',
  };

  const contactParams = new URLSearchParams(window.location.search);
  const selectedGymSlug = contactParams.get('gym') ?? '';
  const selectedGymName = gymNames[selectedGymSlug] ?? '';
  const selectedGymNote = document.getElementById('selected-gym-note');
  const selectedGymNameNode = document.getElementById('selected-gym-name');
  const preferredGymInput = document.getElementById('preferredGym');

  if (selectedGymName && selectedGymNote && selectedGymNameNode && preferredGymInput) {
    selectedGymNameNode.textContent = selectedGymName;
    preferredGymInput.value = selectedGymName;
    selectedGymNote.classList.remove('hidden');
  }

  document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget;
    const status = document.getElementById('form-status');
    const submitBtn = form.querySelector('button[type="submit"]');
    const formData = new FormData(form);
    const fieldValue = (fieldName) => {
      return String(formData.get(fieldName) ?? '').trim();
    };

    if (!status || !submitBtn) {
      return;
    }

    // Honeypot check
    if (fieldValue('website')) {
      return;
    }

    // Basic validation
    const name = fieldValue('name');
    const phone = fieldValue('phone');
    if (!name || !phone) {
      status.textContent = 'Пожалуйста, заполните обязательные поля (Имя и Телефон)';
      status.className = 'rounded-lg p-4 text-sm font-medium bg-red-50 text-red-700 border border-red-200';
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Подготовка...';

    const subject = fieldValue('formType') === 'enrollment'
      ? 'Заявка на тренировку'
      : 'Сообщение с сайта';
    const body = [
      `Имя: ${name}`,
      `Телефон: ${phone}`,
      `Email: ${fieldValue('email') || '-'}`,
      `Возраст ребёнка: ${fieldValue('childAge') || '-'}`,
      `Желаемый зал: ${selectedGymName || '-'}`,
      '',
      'Сообщение:',
      fieldValue('message') || '-',
    ].join('\n');
    const mailtoUrl = `mailto:ashiharakarate23@mail.ru?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

    window.location.href = mailtoUrl;
    status.innerHTML = 'Мы подготовили письмо с заявкой. Если почта не открылась, позвоните: <a class="underline" href="tel:+79184483558">+7 (918) 448-35-58</a>.';
    status.className = 'rounded-lg p-4 text-sm font-medium bg-green-50 text-green-700 border border-green-200';
    submitBtn.disabled = false;
    submitBtn.textContent = 'Подготовить письмо';
  });
</script>
