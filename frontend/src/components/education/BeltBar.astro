---
import type { CollectionEntry } from 'astro:content';
import { getBeltVisual } from '../../lib/belts';

type Size = 'small' | 'default' | 'big';

interface Props {
  belt: CollectionEntry<'belts'>;
  size?: Size;
}

const { belt, size = 'default' } = Astro.props;
const visual = getBeltVisual(belt);
const stripes = visual.stripe ? Array.from({ length: visual.stripeCount }) : [];

// Размер полосы, отступ и зазор блока полосок, ширина одной полоски
const sizes: Record<Size, { bar: string; stripes: string; stripe: string }> = {
  small: { bar: 'h-[14px]', stripes: 'right-2 gap-[3px]', stripe: 'w-1' },
  default: { bar: 'h-5', stripes: 'right-3 gap-1', stripe: 'w-[5px]' },
  big: { bar: 'h-[30px]', stripes: 'right-[18px] gap-[6px]', stripe: 'w-[7px]' },
};
const cls = sizes[size];
---

<div
  class:list={['relative overflow-hidden rounded-[2px]', cls.bar]}
  style={`background: ${visual.base}; background-image: linear-gradient(rgba(255,255,255,0.14), rgba(0,0,0,0.06) 45%, rgba(0,0,0,0.14)); border: 1px solid ${visual.border ?? 'rgba(0,0,0,0.12)'}; box-shadow: inset 0 1px 0 rgba(255,255,255,0.15);`}
  aria-hidden="true"
>
  <div class:list={['absolute top-0 bottom-0 flex', cls.stripes]}>
    {stripes.map(() => (
      <div
        class:list={['h-full', cls.stripe]}
        style={`background: ${visual.stripe}; box-shadow: 0 0 0 0.5px rgba(0,0,0,0.15);`}
      ></div>
    ))}
  </div>
</div>
