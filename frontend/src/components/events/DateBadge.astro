---
import { eventDateParts } from '../../lib/events';

// Бейдж даты: число, месяц и красная полоса (год в списках, день недели в программе)
interface Props {
  date: Date;
  stripe?: string;
  bg?: 'cream' | 'white';
  size?: 'md' | 'sm';
}

const { date, stripe, bg = 'cream', size = 'md' } = Astro.props;
const { day, month, year } = eventDateParts(date);
---

<div
  class:list={[
    'flex shrink-0 flex-col items-center overflow-hidden rounded-[16px] border border-line',
    bg === 'white' ? 'bg-white' : 'bg-cream',
    size === 'sm' ? 'w-[56px]' : 'w-[62px]',
  ]}
>
  <div class:list={['pt-[9px] pb-[3px] font-black leading-none', size === 'sm' ? 'text-[20px]' : 'text-[21px]']}>{day}</div>
  <div class:list={['font-bold uppercase tracking-[0.04em] text-neutral-800', size === 'sm' ? 'text-[11.5px]' : 'text-[12px]']}>{month}</div>
  <div class="mt-[6px] w-full bg-primary py-[3px] text-center text-[10.5px] font-bold tracking-[0.05em] text-white">{stripe ?? year}</div>
</div>
