---
import type { CollectionEntry } from 'astro:content';
import { withBase, eventTypeLabel } from '../../lib/utils';
import { badgeClasses } from '../../lib/events';
import DateBadge from './DateBadge.astro';

interface Props {
  event: CollectionEntry<'events'>;
}

const { event } = Astro.props;
---

<a
  href={withBase(`/events/${event.id}`)}
  data-type={event.data.eventType}
  class="flex flex-wrap items-center gap-[clamp(16px,2.5vw,28px)] px-[22px] py-[18px] border-b border-line-soft last:border-b-0 hover:bg-neutral-50"
>
  <DateBadge date={event.data.eventDate} />
  <div class="min-w-[220px] flex-1">
    <div class="text-[15.5px] font-bold leading-[1.4]">{event.data.title}</div>
    <div class="mt-[3px] text-[13.5px] leading-[1.5] text-neutral-600">{event.data.excerpt}</div>
  </div>
  <span class={`inline-block whitespace-nowrap rounded-full px-3 py-1.5 text-[12.5px] font-bold ${badgeClasses(event.data.eventType)}`}>
    {eventTypeLabel(event.data.eventType)}
  </span>
</a>
