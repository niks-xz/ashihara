---
import type { CollectionEntry } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';
import EventCard from '../events/EventCard.astro';
import Button from '../ui/Button.astro';

interface Props {
  upcoming: CollectionEntry<'events'>[];
  recent: CollectionEntry<'events'>[];
}

const { upcoming, recent } = Astro.props;
const hasUpcoming = upcoming.length > 0;
const hasRecent = recent.length > 0;
const hasAny = hasUpcoming || hasRecent;
const currentYear = new Date().getFullYear();
---

<section class="py-16 md:py-20">
  <div class="max-w-7xl mx-auto px-4">
    <SectionHeading
      title={hasAny ? 'События федерации' : 'Календарный план'}
      subtitle={hasAny
        ? 'Соревнования, лагеря, аттестации и репортажи с прошедших мероприятий'
        : `План мероприятий на ${currentYear} год формируется`}
    />

    {hasUpcoming && (
      <>
        <h3 class="text-xl font-bold text-dark mb-6">Ближайшие</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {upcoming.map((event) => <EventCard event={event} />)}
        </div>
      </>
    )}

    {hasRecent && (
      <>
        <h3 class:list={['text-xl font-bold text-dark mb-6', hasUpcoming && 'mt-12']}>Недавние</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {recent.map((event) => <EventCard event={event} />)}
        </div>
      </>
    )}

    {hasAny ? (
      <div class="mt-10 text-center">
        <Button href="/events" variant="outline">Все события</Button>
      </div>
    ) : (
      <div class="max-w-3xl mx-auto rounded-xl border border-neutral-200 bg-white p-6 md:p-8 text-center shadow-sm">
        <p class="text-lg font-semibold text-dark mb-3">
          План мероприятий на {currentYear} год формируется
        </p>
        <p class="text-neutral-700 leading-relaxed mb-6">
          После утверждения календаря здесь появятся ближайшие соревнования,
          семинары и аттестации.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <Button href="/calendar">Календарный план</Button>
          <Button href="/events" variant="outline">Архив событий</Button>
        </div>
      </div>
    )}
  </div>
</section>
