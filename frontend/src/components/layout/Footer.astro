---
import { withBase } from '../../lib/utils';

const currentYear = new Date().getFullYear();

const navColumns = [
  {
    title: 'Навигация',
    links: [
      { href: '/about', label: 'О федерации' },
      { href: '/kids', label: 'Детям' },
      { href: '/schedule', label: 'Расписание' },
      { href: '/coaches', label: 'Тренеры' },
    ],
  },
  {
    title: 'Информация',
    links: [
      { href: '/gyms', label: 'Адреса залов' },
      { href: '/student-path', label: 'Путь ученика' },
      { href: '/events', label: 'События' },
      { href: '/calendar', label: 'Календарь' },
      { href: '/methodology', label: 'Методичка' },
      { href: '/contacts', label: 'Контакты' },
    ],
  },
];
---

<footer class="bg-dark text-neutral-300">
  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 bg-primary rounded-lg flex items-center justify-center text-white font-bold text-lg">
            A
          </div>
          <div>
            <div class="text-white font-bold">Ашихара-каратэ</div>
            <div class="text-sm text-neutral-400">Краснодарский край</div>
          </div>
        </div>
        <p class="text-sm text-neutral-400 max-w-md mb-4">
          Федерация Ашихара-каратэ Краснодарского края. Член организации NIKO (Новая Международная Организация Ашихара Каратэ Кайкан).
        </p>
        <div class="flex items-center gap-3">
          <a href="https://vk.com/id710680478" target="_blank" rel="noopener" class="w-9 h-9 rounded-lg bg-dark-light flex items-center justify-center text-neutral-400 hover:text-white hover:bg-primary transition-colors" aria-label="VK">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M21.547 7.144c.15-.498 0-.863-.708-.863h-2.34c-.595 0-.87.315-1.02.662 0 0-1.192 2.906-2.88 4.794-.546.547-.795.72-1.093.72-.15 0-.367-.173-.367-.67V7.143c0-.596-.173-.863-.67-.863H9.76c-.373 0-.597.277-.597.54 0 .566.845.697.932 2.29v3.459c0 .758-.137.897-.435.897-.795 0-2.73-2.92-3.876-6.26C5.593 6.64 5.397 6.28 4.8 6.28H2.46c-.67 0-.803.315-.803.662 0 .62.795 3.697 3.703 7.764C7.3 17.672 10.053 19 12.578 19c1.517 0 1.704-.34 1.704-.928v-2.1c0-.67.142-.803.614-.803.348 0 .944.174 2.337 1.517C18.834 18.29 19.108 19 20.005 19h2.34c.67 0 1.005-.34.812-1.012-.212-.67-1.012-1.64-2.063-2.79-.57-.67-1.425-1.392-1.685-1.76-.348-.447-.248-.645 0-1.043 0 0 2.831-3.98 3.128-5.332z"/></svg>
          </a>
        </div>
      </div>

      {navColumns.map((col) => (
        <div>
          <h3 class="text-white font-semibold mb-4">{col.title}</h3>
          <ul class="space-y-2">
            {col.links.map(({ href, label }) => (
              <li>
                <a href={withBase(href)} class="text-sm text-neutral-400 hover:text-white transition-colors">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 pt-6 border-t border-dark-light flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-neutral-600">
      <span>&copy; {currentYear} Федерация Ашихара-каратэ Краснодарского края</span>
      <span>Организация NIKO</span>
    </div>
  </div>
</footer>
