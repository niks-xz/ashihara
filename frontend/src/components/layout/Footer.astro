---
import { withBase } from '../../lib/utils';

const currentYear = new Date().getFullYear();

const navColumns = [
  {
    title: 'Навигация',
    links: [
      { href: '/about', label: 'О федерации' },
      { href: '/kids', label: 'Детям' },
      { href: '/coaches', label: 'Тренеры' },
    ],
  },
  {
    title: 'Информация',
    links: [
      { href: '/gyms', label: 'Адреса залов' },
      { href: '/student-path', label: 'Путь ученика' },
      { href: '/events', label: 'События' },
      { href: '/calendar', label: 'Календарь' },
      { href: '/methodology', label: 'Методичка' },
      { href: '/contacts', label: 'Контакты' },
    ],
  },
];
---

<footer class="bg-dark text-neutral-300">
  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 bg-primary rounded-lg flex items-center justify-center text-white font-bold text-lg">
            A
          </div>
          <div>
            <div class="text-white font-bold">Ашихара-каратэ</div>
            <div class="text-sm text-neutral-400">г. Краснодар</div>
          </div>
        </div>
        <p class="text-sm text-neutral-400 max-w-md mb-4">
          Федерация Ашихара-каратэ г. Краснодара. Член организации NIKO (Новая Международная Организация Ашихара Каратэ Кайкан).
        </p>
      </div>

      {navColumns.map((col) => (
        <div>
          <h3 class="text-white font-semibold mb-4">{col.title}</h3>
          <ul class="space-y-2">
            {col.links.map(({ href, label }) => (
              <li>
                <a href={withBase(href)} class="text-sm text-neutral-400 hover:text-white transition-colors">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 border-t border-dark-light pt-6">
      <h3 class="text-sm font-semibold text-neutral-300">Реквизиты</h3>
      <dl class="mt-3 grid gap-x-8 gap-y-2 text-sm text-neutral-500 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <dt class="inline text-neutral-400">Организация: </dt>
          <dd class="inline">Общественная организация Федерация «Ашихара-каратэ» г. Краснодара</dd>
        </div>
        <div class="sm:col-span-2">
          <dt class="inline text-neutral-400">Адрес: </dt>
          <dd class="inline">350000, г. Краснодар, ул. Уральская, 112</dd>
        </div>
        <div>
          <dt class="inline text-neutral-400">ОГРН: </dt>
          <dd class="inline">1032335019122</dd>
        </div>
        <div>
          <dt class="inline text-neutral-400">ИНН / КПП: </dt>
          <dd class="inline">2312080189 / 231201001</dd>
        </div>
        <div>
          <dt class="inline text-neutral-400">Президент: </dt>
          <dd class="inline">Шихов Андрей Владимирович</dd>
        </div>
        <div>
          <dt class="inline text-neutral-400">Email: </dt>
          <dd class="inline">
            <a href="mailto:ashiharakarate23@mail.ru" class="hover:text-neutral-300 transition-colors">
              ashiharakarate23@mail.ru
            </a>
          </dd>
        </div>
      </dl>
    </div>

    <div class="mt-8 pt-6 border-t border-dark-light flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-neutral-600">
      <span>&copy; {currentYear} Федерация Ашихара-каратэ г. Краснодара</span>
      <span>Организация NIKO</span>
    </div>
  </div>
</footer>
