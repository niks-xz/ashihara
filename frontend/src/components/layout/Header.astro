---
import { Image } from 'astro:assets';
import nikoLogo from '../../assets/niko-logo.png';
import { withBase } from '../../lib/utils';

const nav = [
  { href: '/', label: 'Главная' },
  { href: '/events', label: 'События' },
  { href: '/gyms', label: 'Залы' },
  { href: '/coaches', label: 'Тренеры' },
  { href: '/education', label: 'Обучение' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
function isActive(href: string): boolean {
  if (href === '/') {
    return path === '/';
  }
  return path.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-cream/90 backdrop-blur-md border-b border-line">
  <div class="max-w-[1180px] mx-auto px-[22px] flex items-center gap-4 flex-wrap min-h-[66px]">
    <a href={withBase('/')} class="flex items-center gap-3 py-2.5">
      <Image src={nikoLogo} alt="Эмблема Ашихара кайкан" width={80} height={80} class="w-10 h-10 block" />
      <span class="flex flex-col leading-[1.1]">
        <span class="font-extrabold text-base tracking-tight text-dark">Ашихара-каратэ</span>
        <span class="text-[11px] font-semibold text-neutral-600">Федерация · Краснодарский край</span>
      </span>
    </a>
    <nav class="flex items-center gap-0.5 flex-wrap ml-auto">
      {nav.map(({ href, label }) => (
        <a
          href={withBase(href)}
          class:list={[
            'font-semibold text-[14.5px] px-[13px] py-2 rounded-full transition-colors',
            isActive(href) ? 'text-dark bg-cream-dark' : 'text-neutral-700 hover:text-dark',
          ]}
        >
          {label}
        </a>
      ))}
      <a
        href={withBase('/gyms')}
        class="ml-3 bg-primary text-white rounded-full font-bold text-sm px-5 py-[9.5px] shadow-[0_6px_16px_rgba(185,33,54,0.28)] hover:bg-primary-dark transition-colors"
      >
        Записаться
      </a>
    </nav>
  </div>
</header>
