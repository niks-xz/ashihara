---
import type { CollectionEntry } from 'astro:content';
import { getBeltVisual } from '../../lib/belts';

interface Props {
  belt: CollectionEntry<'belts'>;
  class?: string;
  stripeClass?: string;
}

const {
  belt,
  class: className = 'w-16 h-6',
  stripeClass = 'w-[4px]',
} = Astro.props;
const visual = getBeltVisual(belt);
const borderColor = visual.border ?? visual.base;
const stripes = visual.stripe ? Array.from({ length: visual.stripeCount }) : [];
---

<div
  class:list={[
    className,
    'rounded-sm shrink-0 relative overflow-hidden flex items-center justify-end gap-1 pr-1',
  ]}
  style={`background-color: ${visual.base}; box-shadow: inset 0 1px 2px rgba(0,0,0,0.15), 0 1px 2px rgba(0,0,0,0.1); border: 1px solid ${borderColor};`}
  aria-hidden="true"
>
  {stripes.map(() => (
    <div
      class:list={[
        stripeClass,
        'h-full shrink-0 rounded-[0.5px]',
      ]}
      style={`background-color: ${visual.stripe};`}
    />
  ))}
</div>
