---
import type { CollectionEntry } from 'astro:content';
import VkVideo from '../ui/VkVideo.astro';

interface Props {
  videos: CollectionEntry<'kata-videos'>[];
}

const { videos } = Astro.props;
---

{videos.length > 0 && (
  <div class="mt-10">
    <h3 class="text-lg font-bold text-dark mb-4">Видео ката</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {videos.map((video) => (
        <div>
          <VkVideo url={video.data.vkVideoUrl} title={video.data.title} />
          <p class="mt-2 text-sm font-medium text-neutral-700">{video.data.title}</p>
          {video.data.description && (
            <p class="text-sm text-neutral-600">{video.data.description}</p>
          )}
        </div>
      ))}
    </div>
  </div>
)}
