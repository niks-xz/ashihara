---
import type { CollectionEntry } from 'astro:content';

type Belt = CollectionEntry<'belts'>;

interface Props {
  strengthTest: Belt['data']['strengthTest'];
  sections: Belt['data']['sections'];
}

const { strengthTest, sections } = Astro.props;
---

{strengthTest.length > 0 && (
  <section class="mb-8">
    <h2 class="text-lg font-bold text-dark mb-3">Силовой тест</h2>
    <div class="overflow-hidden rounded-lg border border-neutral-300">
      <div class="grid grid-cols-[1fr_auto] bg-neutral-100 text-xs font-semibold uppercase tracking-wide text-neutral-700">
        <div class="px-4 py-2.5">Упражнение</div>
        <div class="px-4 py-2.5 w-24 text-right sm:w-32">Кол-во</div>
      </div>
      {strengthTest.map((row, i) => (
        <div class:list={[
          'grid grid-cols-[1fr_auto] border-t border-neutral-300',
          i % 2 === 0 ? 'bg-white' : 'bg-neutral-50',
        ]}>
          <div class="px-4 py-2.5 text-sm text-neutral-800">{row.exercise}</div>
          <div class="px-4 py-2.5 w-24 text-right text-sm font-semibold text-dark sm:w-32">{row.count}</div>
        </div>
      ))}
    </div>
  </section>
)}

{sections.map((section) => (
  <section class="mb-8">
    <h2 class="text-lg font-bold text-dark">{section.title}</h2>
    {section.note && (
      <p class="mt-1 text-sm text-neutral-600">Включает: {section.note}</p>
    )}

    <div class="mt-3 space-y-4 rounded-lg border border-neutral-300 bg-white p-5">
      {section.groups.map((group) => (
        <div>
          {group.title && (
            <h3 class="mb-2 text-sm font-semibold uppercase tracking-wide text-primary">
              {group.title}
            </h3>
          )}
          <ul class="space-y-2">
            {group.items.map((item) => (
              <li class="flex gap-3 text-neutral-800">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
))}
