---
import type { RequirementRow } from '../../lib/belts';

interface Props {
  title: string;
  rows: RequirementRow[];
}

const { title, rows } = Astro.props;
---

{rows.length > 0 && (
  <div class="mb-8">
    <h3 class="text-lg font-bold text-dark mb-3">{title}</h3>
    <div class="border border-neutral-300 rounded-lg overflow-hidden">
      <div class="grid grid-cols-[1fr_auto_auto] bg-neutral-100 text-xs font-semibold text-neutral-700 uppercase tracking-wide">
        <div class="px-4 py-2.5">Техника</div>
        <div class="px-4 py-2.5 w-24 sm:w-28">Кол-во</div>
        <div class="px-4 py-2.5 w-28 sm:w-36 hidden sm:block">Примечания</div>
      </div>
      {rows.map((row, i) => (
        <div class:list={[
          'grid grid-cols-[1fr_auto_auto] border-t border-neutral-300',
          i % 2 === 0 ? 'bg-white' : 'bg-neutral-50',
        ]}>
          <div class="px-4 py-2.5 text-sm text-neutral-800">{row.technique}</div>
          <div class="px-4 py-2.5 text-sm text-neutral-700 w-24 sm:w-28">{row.repetitions || '—'}</div>
          <div class="px-4 py-2.5 text-sm text-neutral-700 w-28 sm:w-36 hidden sm:block">{row.notes || '—'}</div>
        </div>
      ))}
    </div>
  </div>
)}
