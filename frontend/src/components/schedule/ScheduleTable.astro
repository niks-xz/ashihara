---
import type { ScheduleEntry, Gym } from '../../lib/types';
import { formatTime } from '../../lib/utils';

interface Props {
  entries: ScheduleEntry[];
  gym: Gym;
}

const { entries, gym } = Astro.props;

const dayOrder = ['Понедельник', 'Вторник', 'Среда', 'Четверг', 'Пятница', 'Суббота', 'Воскресенье'];
const sorted = [...entries].sort((a, b) => {
  const dayDiff = dayOrder.indexOf(a.dayOfWeek) - dayOrder.indexOf(b.dayOfWeek);

  if (dayDiff !== 0) {
    return dayDiff;
  }

  return a.timeStart.localeCompare(b.timeStart);
});
const grouped = new Map<string, ScheduleEntry[]>();

for (const entry of sorted) {
  const dayEntries = grouped.get(entry.dayOfWeek) ?? [];
  dayEntries.push(entry);
  grouped.set(entry.dayOfWeek, dayEntries);
}

const shortDay: Record<string, string> = {
  'Понедельник': 'Пн',
  'Вторник': 'Вт',
  'Среда': 'Ср',
  'Четверг': 'Чт',
  'Пятница': 'Пт',
  'Суббота': 'Сб',
  'Воскресенье': 'Вс',
};
---

<div class="rounded-xl border border-neutral-200 bg-white shadow-sm overflow-hidden">
  <div class="px-6 py-4 bg-dark">
    <h3 class="text-lg font-bold text-white">{gym.name}</h3>
    <p class="text-sm text-neutral-300">{gym.address}</p>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full min-w-[40rem] text-sm">
      <thead>
        <tr class="border-y border-neutral-200 bg-neutral-50">
          <th class="sticky left-0 z-20 bg-neutral-50 text-left px-6 py-3 font-semibold text-neutral-700 border-r border-neutral-200">День</th>
          <th class="text-left px-6 py-3 font-semibold text-neutral-700">Время</th>
          <th class="text-left px-6 py-3 font-semibold text-neutral-700">Группа</th>
          <th class="text-left px-6 py-3 font-semibold text-neutral-700">Тренер</th>
        </tr>
      </thead>
      <tbody>
        {[...grouped.entries()].map(([day, dayEntries]) =>
          dayEntries.map((entry, index) => (
            <tr class="border-b border-neutral-100">
              {index === 0 && (
                <td
                  class="sticky left-0 z-10 bg-primary/5 px-6 py-3 font-semibold text-dark align-middle whitespace-nowrap border-r border-neutral-200 border-t-2 border-t-primary/20"
                  rowspan={dayEntries.length}
                >
                  <span class="hidden sm:inline">{day}</span>
                  <span class="sm:hidden">{shortDay[day] ?? day}</span>
                </td>
              )}
              <td class:list={['px-6 py-3 text-neutral-700 whitespace-nowrap', index === 0 && 'border-t-2 border-t-primary/20']}>
                {formatTime(entry.timeStart)} - {formatTime(entry.timeEnd)}
              </td>
              <td class:list={['px-6 py-3 text-neutral-700', index === 0 && 'border-t-2 border-t-primary/20']}>{entry.groupName}</td>
              <td class:list={['px-6 py-3 text-neutral-700', index === 0 && 'border-t-2 border-t-primary/20']}>{entry.coach?.fullName || '-'}</td>
            </tr>
          ))
        )}
      </tbody>
    </table>
  </div>
</div>
