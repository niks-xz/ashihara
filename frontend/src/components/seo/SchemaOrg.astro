---
interface Props {
  type?: 'organization' | 'event' | 'gym';
  eventData?: {
    name: string;
    startDate: string;
    location?: string;
    description?: string;
  };
  // Зал: собственный адрес и телефон площадки для локального поиска
  gymData?: {
    name: string;
    address: string;
    telephone?: string;
    image?: string;
    openingHours?: string[];
  };
  phone?: string;
  email?: string;
}

const { type = 'organization', eventData, gymData, phone, email } = Astro.props;

// «г. Краснодар, ул. Димитрова, 95» -> улица и город отдельно
function splitAddress(address: string): { street: string; locality: string } {
  const match = address.match(/^(?:г\.|ст\.)\s*([^,]+),\s*(.+)$/);
  if (match) {
    return { locality: match[1].trim(), street: match[2].trim() };
  }
  return { locality: 'Краснодар', street: address };
}
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: 'Федерация Ашихара-каратэ г. Краснодара',
  legalName: 'Общественная организация Федерация «Ашихара-каратэ» г. Краснодара',
  url: siteUrl,
  telephone: phone ?? '+7 (918) 448-35-58',
  email: email ?? 'ashiharakarate23@mail.ru',
  taxID: '2312080189',
  address: {
    '@type': 'PostalAddress',
    postalCode: '350000',
    streetAddress: 'ул. Уральская, 112',
    addressLocality: 'Краснодар',
    addressRegion: 'Краснодарский край',
    addressCountry: 'RU',
  },
  founder: {
    '@type': 'Person',
    name: 'Шихов Андрей Владимирович',
  },
  sport: 'Ashihara Karate',
  memberOf: {
    '@type': 'SportsOrganization',
    name: 'NIKO — Новая Международная Организация Ашихара Каратэ Кайкан',
    url: 'https://ashihara-karate.net/',
  },
};

const eventSchema = eventData
  ? {
      '@context': 'https://schema.org',
      '@type': 'Event',
      name: eventData.name,
      startDate: eventData.startDate,
      ...(eventData.description && { description: eventData.description }),
      ...(eventData.location && {
        location: {
          '@type': 'Place',
          name: eventData.location,
        },
      }),
      organizer: {
        '@type': 'SportsOrganization',
        name: 'Федерация Ашихара-каратэ г. Краснодара',
        url: siteUrl,
      },
    }
  : null;

const gymSchema = gymData
  ? (() => {
      const { street, locality } = splitAddress(gymData.address);
      return {
        '@context': 'https://schema.org',
        '@type': 'SportsActivityLocation',
        name: `${gymData.name} - Ашихара-каратэ`,
        url: Astro.url.href,
        ...(gymData.telephone && { telephone: gymData.telephone }),
        ...(gymData.image && { image: new URL(gymData.image, Astro.site).href }),
        ...(gymData.openingHours?.length && { openingHours: gymData.openingHours }),
        address: {
          '@type': 'PostalAddress',
          streetAddress: street,
          addressLocality: locality,
          addressRegion: 'Краснодарский край',
          addressCountry: 'RU',
        },
        sport: 'Karate',
        parentOrganization: {
          '@type': 'SportsOrganization',
          name: 'Федерация Ашихара-каратэ г. Краснодара',
          url: siteUrl,
        },
      };
    })()
  : null;

const schema = type === 'event' && eventSchema
  ? eventSchema
  : type === 'gym' && gymSchema
    ? gymSchema
    : orgSchema;
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
