---
interface Props {
  type?: 'organization' | 'event';
  eventData?: {
    name: string;
    startDate: string;
    location?: string;
    description?: string;
  };
  phone?: string;
  email?: string;
}

const { type = 'organization', eventData, phone, email } = Astro.props;
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: 'Федерация Ашихара-каратэ Краснодарского края',
  url: siteUrl,
  ...(phone && { telephone: phone }),
  ...(email && { email }),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Краснодар',
    addressRegion: 'Краснодарский край',
    addressCountry: 'RU',
  },
  sport: 'Ashihara Karate',
  memberOf: {
    '@type': 'SportsOrganization',
    name: 'NIKO — Новая Международная Организация Ашихара Каратэ Кайкан',
  },
};

const eventSchema = eventData
  ? {
      '@context': 'https://schema.org',
      '@type': 'Event',
      name: eventData.name,
      startDate: eventData.startDate,
      ...(eventData.description && { description: eventData.description }),
      ...(eventData.location && {
        location: {
          '@type': 'Place',
          name: eventData.location,
        },
      }),
      organizer: {
        '@type': 'SportsOrganization',
        name: 'Федерация Ашихара-каратэ Краснодарского края',
        url: siteUrl,
      },
    }
  : null;

const schema = type === 'event' && eventSchema ? eventSchema : orgSchema;
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
