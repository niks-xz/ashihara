---
interface Props {
  url: string;
  title?: string;
}

const { url, title = 'Видео' } = Astro.props;

// VK Video URL -> embed URL conversion
function getEmbedUrl(vkUrl: string): string {
  // Already an embed URL
  if (vkUrl.includes('vk.com/video_ext.php')) return vkUrl;

  // Parse VK video URL: https://vk.com/video-XXXXX_YYYYY
  const match = vkUrl.match(/video(-?\d+)_(\d+)/);
  if (match) {
    return `https://vk.com/video_ext.php?oid=${match[1]}&id=${match[2]}&hd=2`;
  }

  return vkUrl;
}

const embedUrl = getEmbedUrl(url);
---

<div class="aspect-video rounded-lg overflow-hidden bg-neutral-100">
  <iframe
    src={embedUrl}
    width="100%"
    height="100%"
    allow="autoplay; encrypted-media; fullscreen; picture-in-picture; screen-wake-lock;"
    frameborder="0"
    allowfullscreen
    title={title}
    loading="lazy"
  ></iframe>
</div>
