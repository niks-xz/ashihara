---
import BaseHead from '../components/seo/BaseHead.astro';
import SchemaOrg from '../components/seo/SchemaOrg.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  titleSuffix?: boolean;
  noindex?: boolean;
  schemaType?: 'organization' | 'event' | 'gym';
  eventData?: {
    name: string;
    startDate: string;
    location?: string;
    description?: string;
  };
  gymData?: {
    name: string;
    address: string;
    telephone?: string;
    image?: string;
  };
}

const { title, description, ogImage, titleSuffix, noindex, schemaType, eventData, gymData } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <BaseHead title={title} description={description} ogImage={ogImage} titleSuffix={titleSuffix} noindex={noindex} />
    <SchemaOrg type={schemaType} eventData={eventData} gymData={gymData} />
  </head>
  <body>
    <slot />
  </body>
</html>
