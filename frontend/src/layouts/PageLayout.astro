---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  schemaType?: 'organization' | 'event';
  eventData?: {
    name: string;
    startDate: string;
    location?: string;
    description?: string;
  };
}

const { title, description, ogImage, schemaType, eventData } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage} schemaType={schemaType} eventData={eventData}>
  <Header />
  <main class="min-h-[60vh]">
    <slot />
  </main>
  <Footer />
</BaseLayout>
