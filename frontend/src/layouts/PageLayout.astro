---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  titleSuffix?: boolean;
  noindex?: boolean;
  schemaType?: 'organization' | 'event' | 'gym';
  eventData?: {
    name: string;
    startDate: string;
    location?: string;
    description?: string;
  };
  gymData?: {
    name: string;
    address: string;
    telephone?: string;
    image?: string;
  };
}

const { title, description, ogImage, titleSuffix, noindex, schemaType, eventData, gymData } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  titleSuffix={titleSuffix}
  noindex={noindex}
  schemaType={schemaType}
  eventData={eventData}
  gymData={gymData}
>
  <Header />
  <main class="min-h-[60vh]">
    <slot />
  </main>
  <Footer />
</BaseLayout>
