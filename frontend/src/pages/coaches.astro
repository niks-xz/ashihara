---
import PageLayout from '../layouts/PageLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import CoachCard from '../components/coaches/CoachCard.astro';
import { coaches as allCoaches } from '../data/content';

const coaches = [...allCoaches].sort((a, b) => a.sortOrder - b.sortOrder);
---

<PageLayout
  title="Тренеры"
  description="Тренерский состав Федерации Ашихара-каратэ Краснодарского края. Квалифицированные тренеры с высокими данами."
>
  <section class="py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4">
      <SectionHeading
        title="Наши тренеры"
        subtitle="Опытные тренеры федерации с подтверждённой квалификацией"
      />
      {coaches.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {coaches.map((coach) => <CoachCard coach={coach} />)}
        </div>
      ) : (
        <p class="text-center text-neutral-600">Информация о тренерах скоро появится</p>
      )}
    </div>
  </section>
</PageLayout>
