---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/ui/Button.astro';
import { coaches } from '../../data/content';
import { withBase } from '../../lib/utils';
import type { Coach } from '../../lib/types';

export async function getStaticPaths() {
  return coaches
    .filter((coach) => coach.slug)
    .map((coach) => ({
      params: { slug: coach.slug },
      props: { coach },
    }));
}

interface Props {
  coach: Coach;
}

function splitAchievements(value: string | undefined): string[] {
  if (!value) {
    return [];
  }

  return value
    .split(/\r?\n/)
    .flatMap((line) => line.match(/[^.!?]+[.!?]+|[^.!?]+$/g) ?? [])
    .map((item) => item.trim().replace(/^[•*-]\s*/, ''))
    .filter((item) => item.length > 0);
}

const { coach } = Astro.props;
const achievementItems = splitAchievements(coach.achievements);
const pageDescription = coach.title
  ? `${coach.fullName} - ${coach.title}. Тренер Федерации Ашихара-каратэ Краснодарского края.`
  : `${coach.fullName} - тренер Федерации Ашихара-каратэ Краснодарского края.`;
---

<PageLayout
  title={coach.fullName}
  description={pageDescription}
  ogImage={coach.photo ? withBase(coach.photo.url) : undefined}
>
  <article class="py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-4">
      <div class="mb-8">
        <a href={withBase('/coaches')} class="text-sm text-primary hover:underline">&larr; Все тренеры</a>
      </div>

      <div class="grid gap-8 lg:grid-cols-[20rem_1fr] lg:items-start">
        <aside class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm">
          <div class="w-40 h-40 mx-auto rounded-full overflow-hidden bg-neutral-100">
            {coach.photo ? (
              <img
                src={withBase(coach.photo.url)}
                alt={coach.fullName}
                class="w-full h-full object-cover"
                loading="eager"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center">
                <svg class="w-20 h-20 text-neutral-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0" />
                </svg>
              </div>
            )}
          </div>

          <div class="mt-6 text-center">
            <h1 class="text-2xl font-bold text-dark">{coach.fullName}</h1>
            {coach.rank && <p class="mt-2 text-primary font-semibold">{coach.rank}</p>}
            {coach.title && <p class="mt-1 text-neutral-700">{coach.title}</p>}
          </div>

          {coach.gyms && coach.gyms.length > 0 && (
            <div class="mt-6 pt-6 border-t border-neutral-200">
              <h2 class="text-sm font-semibold text-dark uppercase tracking-wide">Залы</h2>
              <div class="mt-3 flex flex-wrap gap-2">
                {coach.gyms.map((gym) => (
                  <a
                    href={withBase(gym.slug ? `/gyms/${gym.slug}` : '/gyms')}
                    class="text-sm bg-neutral-100 text-neutral-700 px-3 py-1.5 rounded-md hover:bg-primary hover:text-white transition-colors"
                  >
                    {gym.name}
                  </a>
                ))}
              </div>
            </div>
          )}
        </aside>

        <div class="space-y-6">
          {coach.bio && (
            <section class="rounded-xl border border-neutral-200 bg-white p-6 md:p-8 shadow-sm">
              <h2 class="text-xl font-bold text-dark mb-4">О тренере</h2>
              <div class="text-neutral-700 leading-relaxed space-y-4" set:html={coach.bio} />
            </section>
          )}

          {achievementItems.length > 0 && (
            <section class="rounded-xl border border-neutral-200 bg-white p-6 md:p-8 shadow-sm">
              <h2 class="text-xl font-bold text-dark mb-4">Достижения</h2>
              <ul class="space-y-3">
                {achievementItems.map((achievement) => (
                  <li class="flex gap-3 text-neutral-700 leading-relaxed">
                    <span class="mt-2 w-2 h-2 rounded-full bg-primary shrink-0" />
                    <span>{achievement}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {!coach.bio && achievementItems.length === 0 && (
            <section class="rounded-xl border border-neutral-200 bg-white p-6 md:p-8 shadow-sm">
              <p class="text-neutral-700 leading-relaxed">
                Подробная информация о тренере будет добавлена после согласования.
              </p>
            </section>
          )}

          <div class="pt-2">
            <Button href="/coaches" variant="outline">&larr; Все тренеры</Button>
          </div>
        </div>
      </div>
    </div>
  </article>
</PageLayout>
