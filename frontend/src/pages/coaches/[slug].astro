---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/ui/Button.astro';
import { withBase } from '../../lib/utils';

export async function getStaticPaths() {
  const coaches = await getCollection('coaches');

  return coaches.map((coach) => ({
    params: { slug: coach.id },
    props: { coach },
  }));
}

interface Props {
  coach: CollectionEntry<'coaches'>;
}

function splitAchievements(value: string | undefined): string[] {
  if (!value) {
    return [];
  }

  return value
    .split(/\r?\n/)
    .flatMap((line) => line.match(/[^.!?]+[.!?]+|[^.!?]+$/g) ?? [])
    .map((item) => item.trim().replace(/^[•*-]\s*/, ''))
    .filter((item) => item.length > 0);
}

const { coach } = Astro.props;
const { Content } = await render(coach);
const hasBio = Boolean(coach.body?.trim());
const achievementItems = splitAchievements(coach.data.achievements);
const pageDescription = coach.data.title
  ? `${coach.data.fullName} - ${coach.data.title}. Тренер Федерации Ашихара-каратэ г. Краснодара.`
  : `${coach.data.fullName} - тренер Федерации Ашихара-каратэ г. Краснодара.`;
---

<PageLayout
  title={coach.data.fullName}
  description={pageDescription}
>
  <article class="mx-auto max-w-[1180px] px-[22px] py-[clamp(36px,5vw,60px)]">
    <div class="mb-8">
      <a href={withBase('/coaches')} class="text-sm font-semibold text-primary hover:underline">&larr; Все тренеры</a>
    </div>

    <div class="grid gap-8 lg:grid-cols-[20rem_1fr] lg:items-start">
      <aside class="overflow-hidden rounded-[24px] border border-line bg-white">
        <div class="aspect-[2/3] overflow-hidden bg-neutral-200">
          {coach.data.photo ? (
            <Image
              src={coach.data.photo}
              alt={coach.data.fullName}
              width={640}
              height={960}
              class="h-full w-full object-cover"
              loading="eager"
            />
          ) : (
            <div class="flex h-full w-full items-center justify-center">
              <svg class="h-20 w-20 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0" />
              </svg>
            </div>
          )}
        </div>

        <div class="p-6 text-center">
          <h1 class="text-2xl font-extrabold tracking-[-0.015em] text-dark">{coach.data.fullName}</h1>
          {coach.data.rank && (
            <p class="mt-3">
              <span class="rounded-full bg-primary-tint px-3.5 py-1.5 text-[13px] font-extrabold text-primary">{coach.data.rank}</span>
            </p>
          )}
          {coach.data.title && <p class="mt-3 text-sm font-bold text-primary">{coach.data.title}</p>}
        </div>
      </aside>

      <div class="space-y-5">
        {hasBio && (
          <section class="rounded-[20px] border border-line bg-white p-6 md:p-8">
            <h2 class="mb-4 text-xl font-extrabold tracking-tight text-dark">О тренере</h2>
            <div class="space-y-4 leading-[1.6] text-neutral-800">
              <Content />
            </div>
          </section>
        )}

        {achievementItems.length > 0 && (
          <section class="rounded-[20px] border border-line bg-white p-6 md:p-8">
            <h2 class="mb-4 text-xl font-extrabold tracking-tight text-dark">Достижения</h2>
            <ul class="space-y-3">
              {achievementItems.map((achievement) => (
                <li class="flex gap-3 leading-[1.6] text-neutral-800">
                  <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-primary" />
                  <span>{achievement}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {!hasBio && achievementItems.length === 0 && (
          <section class="rounded-[20px] border border-line bg-white p-6 md:p-8">
            <p class="leading-[1.6] text-neutral-800">
              Подробная информация о тренере будет добавлена после согласования.
            </p>
          </section>
        )}

        <div class="pt-2">
          <Button href="/coaches" variant="outline">&larr; Все тренеры</Button>
        </div>
      </div>
    </div>
  </article>
</PageLayout>
