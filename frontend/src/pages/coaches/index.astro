---
import { getCollection, render } from 'astro:content';
import { coachPhoto, sortCoaches } from '../../lib/coaches';
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import { withBase } from '../../lib/utils';

const coaches = sortCoaches(await getCollection('coaches'));
const gyms = (await getCollection('gyms')).sort((a, b) => a.data.sortOrder - b.data.sortOrder);

// Обратный lookup: тренер -> названия залов, в которых он указан в gym.coaches
function gymNamesFor(coachId: string): string {
  const names = gyms
    .filter((gym) => gym.data.coaches.some((ref) => ref.id === coachId))
    .map((gym) => gym.data.name);

  return [...new Set(names)].join(' · ');
}

const cards = await Promise.all(
  coaches.map(async (coach) => {
    const { Content } = await render(coach);

    return {
      coach,
      Content,
      hasBio: Boolean(coach.body?.trim()),
      gymNames: gymNamesFor(coach.id),
    };
  }),
);
---

<PageLayout
  title="Тренеры каратэ в Краснодаре - Федерация Ашихара-каратэ"
  titleSuffix={false}
  description="Тренеры Федерации Ашихара-каратэ в Краснодаре: чемпион мира, чёрные пояса, тренерский опыт с 1996 года. Кто ведёт занятия в каждом зале."
>
  <section class="mx-auto max-w-[1180px] px-[22px] py-[clamp(36px,5vw,60px)]">
    <h1 class="mb-[10px] text-[clamp(30px,4.2vw,46px)] font-black tracking-[-0.025em]">Тренеры федерации</h1>
    <p class="mb-8 max-w-[620px] text-base leading-[1.6] text-neutral-800">С детскими и взрослыми группами работают аттестованные тренеры с рангами и соревновательным опытом.</p>

    <div class="flex flex-col gap-5">
      {cards.map(({ coach, Content, hasBio, gymNames }) => (
        <div class="flex flex-wrap items-stretch overflow-hidden rounded-[24px] border border-line bg-white">
          {/* До sm карточка переносит колонки: фото занимает всю ширину, иначе справа остаётся пустое поле */}
          <div class="relative h-[360px] w-full sm:h-auto sm:w-auto sm:aspect-[2/3] sm:min-h-[340px] sm:min-w-[230px] sm:flex-[0_1_280px]">
            <Image
              src={coachPhoto(coach)}
              alt={coach.data.photo ? coach.data.fullName : ''}
              width={640}
              height={960}
              class="absolute inset-0 h-full w-full object-cover object-top"
            />
          </div>

          <div class="flex flex-[1_1_100%] flex-col justify-center p-[clamp(22px,3vw,32px)] sm:flex-[1_1_300px]">
            <div class="mb-3.5 flex flex-wrap gap-2">
              <span class="rounded-full bg-primary-tint px-3.5 py-1.5 text-[13px] font-extrabold text-primary">{coach.data.rank}</span>
              {gymNames && (
                <span class="rounded-full bg-neutral-200 px-3.5 py-1.5 text-[13px] font-bold text-neutral-800">{gymNames}</span>
              )}
            </div>

            <a
              href={withBase(`/coaches/${coach.id}`)}
              class="mb-1 text-[clamp(21px,2.4vw,25px)] font-extrabold leading-[1.2] tracking-[-0.015em] text-dark transition-colors hover:text-primary"
            >
              {coach.data.fullName}
            </a>
            <div class="mb-[13px] text-[14.5px] font-bold text-primary">{coach.data.title}</div>

            {coach.data.achievements && (
              <p class="mb-[11px] max-w-[560px] text-sm leading-[1.6] text-dark-surface">{coach.data.achievements}</p>
            )}

            {hasBio && (
              <div class="max-w-[560px] space-y-2 text-sm leading-[1.6] text-neutral-600">
                <Content />
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
</PageLayout>
