---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import ContactForm from '../components/contacts/ContactForm.astro';

const gyms = (await getCollection('gyms'))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .map((gym) => ({ slug: gym.id, name: gym.data.name }));
---

<PageLayout
  title="Контакты"
  description="Контакты Федерации Ашихара-каратэ Краснодарского края. Запись на тренировки, адреса залов, телефон, email."
>
  <section class="py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4">
      <div class="mb-10 text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-dark">
          Контакты
        </h1>
        <p class="mt-3 text-lg text-neutral-700 max-w-2xl mx-auto">
          Свяжитесь с нами или запишитесь на тренировку
        </p>
        <div class="mt-4 h-1 w-16 bg-primary rounded-full mx-auto"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Contact Form -->
        <div>
          <h3 class="text-xl font-bold text-dark mb-6">Записаться на тренировку</h3>
          <ContactForm formType="enrollment" gyms={gyms} />
        </div>

        <!-- Contact Info -->
        <div>
          <h3 class="text-xl font-bold text-dark mb-6">Наши контакты</h3>

          <div class="space-y-5">
            <div class="flex items-center gap-4 p-4 bg-white rounded-xl border border-neutral-200">
              <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <div>
                <div class="text-xs font-medium text-neutral-600 uppercase tracking-wide">Email</div>
                <a href="mailto:ashiharakarate23@mail.ru" class="text-dark hover:text-primary transition-colors font-medium">
                  ashiharakarate23@mail.ru
                </a>
              </div>
            </div>

            <div class="flex items-center gap-4 p-4 bg-white rounded-xl border border-neutral-200">
              <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </div>
              <div>
                <div class="text-xs font-medium text-neutral-600 uppercase tracking-wide">Адрес</div>
                <span class="text-dark font-medium">г. Краснодар, Краснодарский край</span>
              </div>
            </div>

            <div class="flex items-center gap-4 p-4 bg-white rounded-xl border border-neutral-200">
              <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
              </div>
              <div>
                <div class="text-xs font-medium text-neutral-600 uppercase tracking-wide">Телефон</div>
                <a href="tel:+79184483558" class="text-dark hover:text-primary transition-colors font-medium">
                  +7 (918) 448-35-58
                </a>
              </div>
            </div>
          </div>

          <div class="mt-6">
            <div class="text-xs font-medium text-neutral-600 uppercase tracking-wide mb-3">Соцсети</div>
            <div class="flex gap-3">
              <a href="https://vk.com/id710680478" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-neutral-200 rounded-xl text-sm font-medium text-neutral-700 hover:border-primary hover:text-primary transition-colors">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M21.547 7.144c.15-.498 0-.863-.708-.863h-2.34c-.595 0-.87.315-1.02.662 0 0-1.192 2.906-2.88 4.794-.546.547-.795.72-1.093.72-.15 0-.367-.173-.367-.67V7.143c0-.596-.173-.863-.67-.863H9.76c-.373 0-.597.277-.597.54 0 .566.845.697.932 2.29v3.459c0 .758-.137.897-.435.897-.795 0-2.73-2.92-3.876-6.26C5.593 6.64 5.397 6.28 4.8 6.28H2.46c-.67 0-.803.315-.803.662 0 .62.795 3.697 3.703 7.764C7.3 17.672 10.053 19 12.578 19c1.517 0 1.704-.34 1.704-.928v-2.1c0-.67.142-.803.614-.803.348 0 .944.174 2.337 1.517C18.834 18.29 19.108 19 20.005 19h2.34c.67 0 1.005-.34.812-1.012-.212-.67-1.012-1.64-2.063-2.79-.57-.67-1.425-1.392-1.685-1.76-.348-.447-.248-.645 0-1.043 0 0 2.831-3.98 3.128-5.332z"/></svg>
                ВКонтакте
              </a>
              <a href="https://instagram.com/ashihara_karate_krasnodar" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-neutral-200 rounded-xl text-sm font-medium text-neutral-700 hover:border-primary hover:text-primary transition-colors">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                Instagram
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
