---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const gyms = (await getCollection('gyms'))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .map((gym) => ({ slug: gym.id, name: gym.data.name }));
const gymNames = Object.fromEntries(gyms.map((gym) => [gym.slug, gym.name]));

const email = 'ashiharakarate23@mail.ru';
const subject = 'Заявка на тренировку';
const bodyTemplate = [
  'Здравствуйте!',
  '',
  'Хочу записать ребёнка на пробную тренировку.',
  '',
  'Зал: {GYM}',
  'Имя и возраст ребёнка: ',
  'Телефон для связи: ',
  '',
  'Вопрос или комментарий: ',
  '',
].join('\n');
const defaultMailto = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyTemplate.replace('{GYM}', ''))}`;
---

<PageLayout
  title="Контакты"
  description="Контакты Федерации Ашихара-каратэ г. Краснодара. Запись на тренировки, адреса залов, телефон, email."
>
  <section class="py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4">
      <div class="mb-10 text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-dark">
          Контакты
        </h1>
        <p class="mt-3 text-lg text-neutral-700 max-w-2xl mx-auto">
          Свяжитесь с нами или запишитесь на тренировку
        </p>
        <div class="mt-4 h-1 w-16 bg-primary rounded-full mx-auto"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Enrollment -->
        <div>
          <h3 class="text-xl font-bold text-dark mb-6">Записаться на тренировку</h3>

          <div id="selected-gym-note" class="hidden mb-5 rounded-lg border border-primary/20 bg-primary/5 p-4">
            <div class="text-xs font-semibold uppercase tracking-wide text-primary">Выбран зал</div>
            <div id="selected-gym-name" class="mt-1 font-semibold text-dark"></div>
          </div>

          <p class="text-neutral-700 leading-relaxed">
            Нажмите кнопку - в вашем почтовом приложении откроется готовое письмо с заявкой.
            Заполните пропуски, отправьте, и мы свяжемся с вами.
          </p>

          <div class="mt-6 flex flex-col sm:flex-row gap-4">
            <a
              id="enroll-mail"
              href={defaultMailto}
              class="inline-flex items-center justify-center font-semibold rounded-lg transition-colors bg-primary text-white hover:bg-primary-dark px-6 py-3 text-base"
            >
              Написать письмо с заявкой
            </a>
            <a
              href="tel:+79184483558"
              class="inline-flex items-center justify-center font-semibold rounded-lg transition-colors border-2 border-primary text-primary hover:bg-primary hover:text-white px-6 py-3 text-base"
            >
              Позвонить
            </a>
          </div>

          <p class="mt-6 text-sm text-neutral-600">
            Сайт не собирает и не хранит ваши данные: письмо уходит напрямую с вашей почты
            на адрес федерации.
          </p>
        </div>

        <!-- Contact Info -->
        <div>
          <h3 class="text-xl font-bold text-dark mb-6">Наши контакты</h3>

          <div class="space-y-5">
            <div class="flex items-center gap-4 p-4 bg-white rounded-xl border border-neutral-200">
              <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <div>
                <div class="text-xs font-medium text-neutral-600 uppercase tracking-wide">Email</div>
                <a href="mailto:ashiharakarate23@mail.ru" class="text-dark hover:text-primary transition-colors font-medium">
                  ashiharakarate23@mail.ru
                </a>
              </div>
            </div>

            <div class="flex items-center gap-4 p-4 bg-white rounded-xl border border-neutral-200">
              <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </div>
              <div>
                <div class="text-xs font-medium text-neutral-600 uppercase tracking-wide">Адрес</div>
                <span class="text-dark font-medium">350000, г. Краснодар, ул. Уральская, 112</span>
              </div>
            </div>

            <div class="flex items-center gap-4 p-4 bg-white rounded-xl border border-neutral-200">
              <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
              </div>
              <div>
                <div class="text-xs font-medium text-neutral-600 uppercase tracking-wide">Телефон</div>
                <a href="tel:+79184483558" class="text-dark hover:text-primary transition-colors font-medium">
                  +7 (918) 448-35-58
                </a>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>
</PageLayout>

<script is:inline define:vars={{ gymNames, email, subject, bodyTemplate }}>
  const params = new URLSearchParams(window.location.search);
  const gymName = gymNames[params.get('gym') ?? ''] ?? '';

  if (gymName) {
    const note = document.getElementById('selected-gym-note');
    const nameNode = document.getElementById('selected-gym-name');
    const mailLink = document.getElementById('enroll-mail');

    if (note && nameNode && mailLink) {
      nameNode.textContent = gymName;
      note.classList.remove('hidden');
      mailLink.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyTemplate.replace('{GYM}', gymName))}`;
    }
  }
</script>
