---
import { getCollection, type CollectionEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import BeltBar from '../../components/education/BeltBar.astro';
import { getBeltDescription } from '../../lib/belts';
import { translateTerm, canonizeDisplay } from '../../lib/glossary';
import { parseTechniqueList, type TechniqueItem } from '../../lib/techniques';
import { withBase } from '../../lib/utils';

export async function getStaticPaths() {
  const belts = await getCollection('belts');
  return belts.map((belt) => ({ params: { slug: belt.id }, props: { belt } }));
}

interface Props {
  belt: CollectionEntry<'belts'>;
}

const { belt } = Astro.props;
const kataVideos = await getCollection('kata-videos');

function findKataVideo(name: string): CollectionEntry<'kata-videos'> | undefined {
  const needle = name.trim().toLowerCase();
  return kataVideos.find(
    (video) => video.data.title.toLowerCase().includes(needle) || video.data.latinTitle.toLowerCase().includes(needle),
  );
}

// Отображаемые названия техник приводятся к канону глоссария
// (подсказки-переводы ищутся по исходному написанию методички до канонизации)
function canonizeItem(item: TechniqueItem): TechniqueItem {
  if (item.kind === 'combo') {
    return {
      ...item,
      label: canonizeDisplay(item.label),
      steps: item.steps.map((step) => ({ ...step, text: canonizeDisplay(step.text) })),
    };
  }
  return { ...item, text: canonizeDisplay(item.text) };
}

const parsedSections = belt.data.sections.map((section) => {
  const isKata = /ката/i.test(section.title);
  return {
    title: section.title,
    note: section.note,
    isKata,
    kataCards: isKata
      ? section.groups
          .flatMap((group) => group.items)
          .map((name) => {
            const video = findKataVideo(name);
            return { name: canonizeDisplay(video?.data.title ?? name), videoUrl: video?.data.videoUrl };
          })
      : [],
    groups: isKata
      ? []
      : section.groups.map((group) => ({
          title: canonizeDisplay(group.title),
          items: group.items.flatMap((item) => parseTechniqueList(item, translateTerm).map(canonizeItem)),
        })),
  };
});

// «Ката» всегда в конце - там видеокарточки
const sections = [...parsedSections.filter((s) => !s.isKata), ...parsedSections.filter((s) => s.isKata)];
---

<PageLayout
  title={`${belt.data.name} — Обучение`}
  description={`Программа аттестации на ${belt.data.name} (${belt.data.beltColor.toLowerCase()} пояс) по Ашихара-каратэ: силовой норматив и набор техники ступени.`}
>
  <section class="mx-auto max-w-[840px] px-[22px] py-[clamp(32px,4.5vw,52px)]">
    <a href={withBase('/education')} class="text-[14.5px] font-bold text-primary hover:underline">← Все пояса</a>
    <h1 class="mt-[22px] mb-[14px] text-[clamp(30px,4.5vw,46px)] font-bold tracking-[-0.02em]">{belt.data.name}</h1>
    <div class="max-w-[360px]">
      <BeltBar belt={belt} big />
    </div>
    <div class="mt-3 mb-8 text-[15px] text-neutral-600">{getBeltDescription(belt)}</div>
    <div class="flex flex-col gap-4">
      {belt.data.strengthTest.length > 0 && (
        <div class="rounded-[20px] border border-line bg-white px-[26px] py-6">
          <div class="mb-4 text-[17px] font-extrabold tracking-[-0.01em]">Силовой тест</div>
          <div class="grid grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-[10px]">
            {belt.data.strengthTest.map((row) => (
              <div class="border-l-2 border-[#F0D6DB] pl-[14px]">
                <div class="text-[26px] font-black tracking-[-0.02em] text-primary">{row.count}</div>
                <div class="mt-[3px] text-[13px] leading-[1.4] text-neutral-800">{row.exercise}</div>
              </div>
            ))}
          </div>
        </div>
      )}
      {sections.map((section) => (
        <div class="rounded-[20px] border border-line bg-white px-[26px] py-6">
          <div class="mb-1 flex flex-wrap items-baseline gap-3">
            <div class="text-[17px] font-extrabold tracking-[-0.01em]">{section.title}</div>
            {section.note && <div class="text-[13px] text-neutral-600">{section.note}</div>}
          </div>
          {section.isKata ? (
            <div class="mt-[14px] grid grid-cols-[repeat(auto-fill,minmax(180px,1fr))] gap-3">
              {section.kataCards.map((kata) => {
                const Tag = kata.videoUrl ? 'a' : 'div';
                return (
                  <Tag
                    href={kata.videoUrl}
                    target={kata.videoUrl ? '_blank' : undefined}
                    rel={kata.videoUrl ? 'noopener' : undefined}
                    class="overflow-hidden rounded-[14px] border border-line transition-colors hover:border-primary"
                  >
                    <div class="relative flex aspect-[16/10] items-center justify-center bg-dark [background-image:repeating-linear-gradient(135deg,rgba(255,255,255,0.04)_0_10px,transparent_10px_20px)]">
                      <div class="flex h-11 w-11 items-center justify-center rounded-full border-[1.5px] border-white/50 bg-white/12">
                        <span class="ml-[3px] text-[15px] text-white">▶</span>
                      </div>
                      <span class="absolute bottom-2 right-[10px] font-mono text-[10px] tracking-[0.05em] text-white/55">видео ката</span>
                    </div>
                    <div class="px-[13px] py-[10px] text-sm font-bold">{kata.name}</div>
                  </Tag>
                );
              })}
            </div>
          ) : (
            <div class="mt-3 flex flex-col gap-[14px]">
              {section.groups.map((group) => (
                <div>
                  {group.title && <div class="mb-[7px] text-[13px] font-extrabold text-primary">{group.title}</div>}
                  <div class="flex flex-col gap-2">
                    {group.items.map((item) =>
                      item.kind === 'combo' ? (
                        <div class="rounded-xl border border-[#EEECE4] bg-neutral-100 px-[14px] py-3">
                          {item.label && (
                            <div class="mb-2 text-xs font-extrabold uppercase tracking-[0.04em] text-primary">{item.label}</div>
                          )}
                          <div class="flex flex-wrap items-center gap-x-1 gap-y-[6px]">
                            {item.steps.map((step, i) => (
                              <span class="inline-flex items-center gap-[6px]">
                                <span
                                  title={step.detail || undefined}
                                  class="rounded-lg border border-line bg-white px-[9px] py-1 text-[13px] leading-[1.3] text-dark-surface"
                                >{step.text}</span>
                                {i < item.steps.length - 1 && <span class="text-xs font-bold text-neutral-400">›</span>}
                              </span>
                            ))}
                          </div>
                        </div>
                      ) : (
                        <div class="flex gap-[10px] text-sm leading-[1.55] text-dark-surface">
                          <span class="shrink-0 font-extrabold text-primary">·</span>
                          {item.detail ? (
                            <span title={item.detail} class="cursor-help border-b border-dashed border-[#C6C4BB]">{item.text}</span>
                          ) : (
                            <span>{item.text}</span>
                          )}
                        </div>
                      ),
                    )}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </section>
</PageLayout>
