---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import EducationTabs from '../../components/education/EducationTabs.astro';
import { buildGlossary } from '../../lib/glossary';
import { withBase } from '../../lib/utils';

const belts = (await getCollection('belts')).sort((a, b) => a.data.sortOrder - b.data.sortOrder);
const glossary = buildGlossary(belts);
---

<PageLayout
  title="Глоссарий"
  description="Глоссарий японских терминов Ашихара-каратэ из программы аттестаций: удары, блоки, стойки и перемещения."
>
  <section class="mx-auto max-w-[1180px] px-[22px] py-[clamp(36px,5vw,60px)]">
    <h1 class="mb-[18px] text-[clamp(28px,3.6vw,40px)] font-bold tracking-[-0.02em]">Обучение</h1>
    <EducationTabs active="glossary" />
    <p class="mb-6 max-w-[680px] text-base leading-[1.6] text-neutral-800 [text-wrap:pretty]">Термины, которые звучат на тренировках и аттестациях, — что они значат и как пишутся по-японски.</p>
    <div class="flex flex-col gap-5">
      {glossary.map((section) => (
        <div>
          <div class="mb-[10px] text-xs font-extrabold uppercase tracking-[0.06em] text-primary">{section.header}</div>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-2">
            {section.terms.map((term) => (
              <div class="rounded-xl border border-line bg-white px-[15px] py-3">
                <div class="flex items-baseline justify-between gap-3">
                  <span class="flex items-center gap-2 text-[14.5px] font-bold">
                    {term.audio && (
                      <button
                        type="button"
                        data-audio={withBase(`/audio/glossary/${term.audio}.mp3`)}
                        aria-label={`Произношение: ${term.name}`}
                        class="flex h-6 w-6 shrink-0 cursor-pointer items-center justify-center rounded-full bg-primary-tint text-[10px] text-primary transition-colors hover:bg-primary hover:text-white"
                      >▶</button>
                    )}
                    {term.name}
                  </span>
                  {term.japanese && <span lang="ja" class="shrink-0 text-[13px] text-neutral-500">{term.japanese}</span>}
                </div>
                <div class="mt-[3px] text-[13px] leading-[1.5] text-neutral-800">{term.detail}</div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
    <p class="mt-8 text-[12px] text-neutral-500">Озвучка терминов: VOICEVOX (голос 青山龍星 / Аояма Рюсэй)</p>
  </section>
</PageLayout>

<script>
  // Safari разрешает воспроизведение только элементу, «разбуженному» жестом пользователя,
  // поэтому Audio создаётся при первом клике, а после смены src обязателен load().
  let player: HTMLAudioElement | null = null;
  let playingSrc = '';

  document.querySelectorAll<HTMLButtonElement>('button[data-audio]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.dataset.audio ?? '';
      if (!src) {
        return;
      }
      if (!player) {
        player = new Audio();
        player.preload = 'auto';
        player.addEventListener('ended', () => { playingSrc = ''; });
      }
      if (playingSrc === src && !player.paused) {
        player.pause();
        playingSrc = '';
        return;
      }
      player.src = src;
      player.load();
      playingSrc = src;
      player.play().catch(() => { playingSrc = ''; });
    });
  });
</script>
