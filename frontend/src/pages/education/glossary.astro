---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import EducationTabs from '../../components/education/EducationTabs.astro';
import { buildGlossary } from '../../lib/glossary';
import { withBase } from '../../lib/utils';

const belts = (await getCollection('belts')).sort((a, b) => a.data.sortOrder - b.data.sortOrder);
const glossary = buildGlossary(belts);

// Якорь секции для оглавления
function anchor(header: string): string {
  return header
    .toLowerCase()
    .replace(/[^а-яёa-z0-9]+/gi, '-')
    .replace(/^-+|-+$/g, '');
}

// Короткая подпись в оглавлении: «Части тела и ударные поверхности» -> «Части тела»
function tocLabel(header: string): string {
  return header.split(/\s+и\s+/)[0];
}

const totalTerms = glossary.reduce((sum, section) => sum + section.terms.length, 0);
---

<PageLayout
  title="Глоссарий"
  description="Глоссарий японских терминов Ашихара-каратэ из программы аттестаций: удары, блоки, стойки и перемещения."
>
  <section class="mx-auto max-w-[1180px] px-[22px] py-[clamp(36px,5vw,60px)]">
    <h1 class="mb-[18px] text-[clamp(28px,3.6vw,40px)] font-bold tracking-[-0.02em]">Обучение</h1>
    <EducationTabs active="glossary" />
    <p class="mb-[18px] max-w-[680px] text-base leading-[1.6] text-neutral-800 [text-wrap:pretty]">Словарь терминов федерации: японское написание, транслитерация и значение. Термины сгруппированы по темам.</p>

    <input
      type="search"
      id="gloss-search"
      placeholder="Поиск: рэй, цуки, защита..."
      aria-label="Поиск по глоссарию"
      autocomplete="off"
      class="mb-[14px] block w-full max-w-[480px] rounded-full border-[1.5px] border-line bg-white px-5 py-3 text-[15px] outline-none focus:border-primary"
    />
    <div id="gloss-count" class="mb-[18px] hidden text-[13.5px] font-semibold text-neutral-600"></div>

    <div id="gloss-toc" class="sticky top-[66px] z-[5] -mx-[22px] mb-[22px] flex flex-wrap gap-[6px] border-b border-line bg-cream/95 px-[22px] py-[10px] backdrop-blur-sm">
      {glossary.map((section) => (
        <button
          type="button"
          data-jump={anchor(section.header)}
          class="cursor-pointer rounded-full border border-line bg-white px-[13px] py-[5px] text-[13px] font-bold text-neutral-800 transition-colors hover:border-primary hover:text-primary"
        >{tocLabel(section.header)}</button>
      ))}
    </div>

    <div class="flex flex-col gap-7">
      {glossary.map((section) => (
        <div id={`gl-${anchor(section.header)}`} data-section>
          <div class="mb-3 border-b border-line pb-2 text-[13px] font-extrabold uppercase tracking-[0.06em] text-primary">{section.header}</div>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(320px,1fr))] gap-2">
            {section.terms.map((term) => (
              <div
                class="flex items-start gap-3 rounded-xl border border-line bg-white px-[15px] py-3"
                data-term-card
                data-search={[term.name, term.detail, term.common, term.japanese].filter(Boolean).join(' ').toLowerCase()}
              >
                {term.audio ? (
                  <button
                    type="button"
                    data-audio={withBase(`/audio/glossary/${term.audio}.mp3`)}
                    aria-label={`Произношение: ${term.name}`}
                    class="mt-[2px] flex h-[30px] w-[30px] shrink-0 cursor-pointer items-center justify-center rounded-full bg-primary-tint text-[11px] text-primary transition-colors hover:bg-primary hover:text-white"
                  >▶</button>
                ) : (
                  <span class="mt-[2px] h-[30px] w-[30px] shrink-0"></span>
                )}
                <div class="min-w-0 flex-1">
                  <div class="flex items-baseline justify-between gap-[10px]">
                    <span class="text-[14.5px] font-bold first-letter:uppercase">{term.name}</span>
                    {term.japanese && <span lang="ja" class="shrink-0 text-[13px] text-neutral-600">{term.japanese}</span>}
                  </div>
                  <div class="mt-[3px] text-[13px] leading-[1.5] text-neutral-800">{term.detail}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div id="gloss-empty" class="hidden py-10 text-center text-neutral-600">
      Ничего не нашлось. Попробуйте другое написание — например, «маваси» или «маваши».
    </div>

    <p class="mt-8 text-[12px] text-neutral-500">Озвучка терминов: VOICEVOX (голос 青山龍星 / Аояма Рюсэй)</p>
  </section>
</PageLayout>

<script define:vars={{ totalTerms }}>
  // Safari разрешает воспроизведение только элементу, «разбуженному» жестом пользователя,
  // поэтому Audio создаётся при первом клике, а после смены src обязателен load().
  let player = null;
  let playingSrc = '';

  document.querySelectorAll('button[data-audio]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.dataset.audio ?? '';
      if (!src) {
        return;
      }
      if (!player) {
        player = new Audio();
        player.preload = 'auto';
        player.addEventListener('ended', () => { playingSrc = ''; });
      }
      if (playingSrc === src && !player.paused) {
        player.pause();
        playingSrc = '';
        return;
      }
      player.src = src;
      player.load();
      playingSrc = src;
      player.play().catch(() => { playingSrc = ''; });
    });
  });

  const search = document.getElementById('gloss-search');
  const counter = document.getElementById('gloss-count');
  const empty = document.getElementById('gloss-empty');
  const toc = document.getElementById('gloss-toc');
  const cards = Array.from(document.querySelectorAll('[data-term-card]'));
  const sections = Array.from(document.querySelectorAll('[data-section]'));

  // «маваши» и «маваси», «ё» и «е» ищутся одинаково
  function normalize(s) {
    return s.toLowerCase().replace(/ё/g, 'е').replace(/[шс]/g, 'с').replace(/[чт]и/g, 'ти').trim();
  }

  function plural(n) {
    const mod10 = n % 10;
    const mod100 = n % 100;
    if (mod10 === 1 && mod100 !== 11) return 'термин';
    if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return 'термина';
    return 'терминов';
  }

  function applySearch(raw) {
    const query = normalize(raw);
    if (!query) {
      cards.forEach((c) => c.classList.remove('hidden'));
      sections.forEach((s) => s.classList.remove('hidden'));
      counter.classList.add('hidden');
      empty.classList.add('hidden');
      toc.classList.remove('hidden');
      return;
    }
    let found = 0;
    for (const card of cards) {
      const hit = normalize(card.dataset.search ?? '').includes(query);
      card.classList.toggle('hidden', !hit);
      if (hit) {
        found++;
      }
    }
    for (const section of sections) {
      const visible = section.querySelectorAll('[data-term-card]:not(.hidden)').length;
      section.classList.toggle('hidden', visible === 0);
    }
    counter.textContent = `Найдено: ${found} ${plural(found)} из ${totalTerms}`;
    counter.classList.remove('hidden');
    empty.classList.toggle('hidden', found > 0);
    toc.classList.toggle('hidden', found === 0);
  }

  search?.addEventListener('input', () => applySearch(search.value));

  document.querySelectorAll('button[data-jump]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const el = document.getElementById(`gl-${btn.dataset.jump}`);
      if (el) {
        window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 126, behavior: 'smooth' });
      }
    });
  });
</script>
