---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import EventCard from '../../components/events/EventCard.astro';

const events = (await getCollection('events'))
  .sort((a, b) => b.data.eventDate.valueOf() - a.data.eventDate.valueOf());

// Группировка по годам: свежие годы сверху, внутри года - по убыванию даты
const years = [...new Set(events.map((e) => e.data.eventDate.getFullYear()))];
const byYear = years.map((year) => ({
  year,
  items: events.filter((e) => e.data.eventDate.getFullYear() === year),
}));
---

<PageLayout
  title="События"
  description="Соревнования, семинары, аттестации и другие мероприятия Федерации Ашихара-каратэ г. Краснодара."
>
  <section class="py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4">
      <SectionHeading
        title="События и новости"
        subtitle="Соревнования, семинары, аттестации и другие мероприятия федерации"
      />

      {events.length > 0 ? (
        byYear.map(({ year, items }) => (
          <div class="mb-12">
            <h3 class="text-2xl font-bold text-dark mb-6">{year}</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {items.map((event) => <EventCard event={event} />)}
            </div>
          </div>
        ))
      ) : (
        <p class="text-center text-neutral-600">Скоро здесь появятся события</p>
      )}
    </div>
  </section>
</PageLayout>
