---
import { getCollection, getEntries, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/ui/Button.astro';
import { gymMarketingBySlug } from '../../data/marketing';
import { getGymSchedule, groupByDay, isYouthRow, uniqueCoaches, SHORT_DAY } from '../../lib/schedule';
import { withBase } from '../../lib/utils';

export async function getStaticPaths() {
  const gyms = await getCollection('gyms');

  return gyms.map((gym) => ({
    params: { slug: gym.id },
    props: { gym },
  }));
}

interface Props {
  gym: CollectionEntry<'gyms'>;
}

const { gym } = Astro.props;
const marketing = gymMarketingBySlug[gym.id];
const sortedRows = await getGymSchedule(gym.id);
const groupedRows = groupByDay(sortedRows);
const youthRows = sortedRows.filter(isYouthRow);
const trialRows = youthRows.length > 0 ? youthRows : sortedRows;
const gymCoaches = await getEntries(gym.data.coaches);
const trialCoaches = uniqueCoaches(trialRows);
const pageDescription = gym.data.description
  ? `${gym.data.name}: ${gym.data.address}. ${gym.data.description}`
  : `${gym.data.name}: ${gym.data.address}. Зал Федерации Ашихара-каратэ г. Краснодара.`;
const mapSearchText = `${gym.data.name}, ${gym.data.address}`;
const yandexMapWidgetUrl = `https://yandex.ru/map-widget/v1/?mode=search&text=${encodeURIComponent(mapSearchText)}&z=16`;
---

<PageLayout
  title={gym.data.name}
  description={pageDescription}
>
  <article class="py-[clamp(36px,5vw,60px)]">
    <div class="max-w-[1180px] mx-auto px-[22px]">
      <div class="mb-8">
        <a href={withBase('/gyms')} class="text-sm text-primary hover:underline">&larr; Все залы</a>
      </div>

      <div class="grid gap-8 lg:grid-cols-[1fr_20rem] lg:items-start">
        <div class="min-w-0 space-y-6">
          <section class="rounded-[20px] border border-line bg-white overflow-hidden">
            {gym.data.photo && (
              <div class="aspect-video bg-neutral-100">
                <Image
                  src={gym.data.photo}
                  alt={gym.data.photoAlt ?? gym.data.name}
                  width={1280}
                  height={720}
                  class="h-full w-full object-cover"
                  loading="eager"
                />
              </div>
            )}
            <div class="p-6 md:p-8">
              <div class="text-[13px] font-bold text-primary">{gym.data.district}</div>
              <h1 class="mt-2 text-3xl md:text-4xl font-black tracking-[-0.025em] text-dark">{gym.data.name}</h1>
              <div class="mt-4 flex items-start gap-3 text-neutral-700">
                <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
                <p>{gym.data.address}</p>
              </div>

              {gym.data.description && (
                <p class="mt-5 text-neutral-700 leading-relaxed">{gym.data.description}</p>
              )}
            </div>
          </section>

          {marketing && (
            <section class="rounded-[20px] border border-line bg-white p-6 md:p-8">
              <div class="grid gap-5 md:grid-cols-2">
                <div class="rounded-[14px] bg-primary-tint p-5">
                  <h2 class="text-lg font-extrabold text-dark">Кому удобно</h2>
                  <p class="mt-3 text-neutral-700 leading-relaxed">{marketing.audience}</p>
                  <div class="mt-4 flex flex-wrap gap-2">
                    {marketing.nearby.map((item) => (
                      <span class="rounded-full bg-white px-3 py-1 text-sm font-medium text-neutral-700 border border-line">
                        {item}
                      </span>
                    ))}
                  </div>
                </div>

                <div class="rounded-[14px] bg-neutral-50 p-5">
                  <h2 class="text-lg font-extrabold text-dark">Первое посещение</h2>
                  <ul class="mt-3 space-y-3 text-neutral-700">
                    <li class="flex gap-3">
                      <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-primary"></span>
                      <span>{marketing.routeHint}</span>
                    </li>
                    <li class="flex gap-3">
                      <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-primary"></span>
                      <span>{marketing.trialNote}</span>
                    </li>
                    <li class="flex gap-3">
                      <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-primary"></span>
                      <span>{marketing.firstVisit}</span>
                    </li>
                  </ul>
                </div>
              </div>
            </section>
          )}

          {trialRows.length > 0 && (
            <section class="rounded-[20px] border border-line bg-white p-6 md:p-8">
              <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                <div>
                  <h2 class="text-xl font-extrabold text-dark">Детские и подростковые группы</h2>
                  <p class="mt-2 text-neutral-700">
                    Для пробного занятия лучше заранее согласовать группу с тренером. Ниже показаны ближайшие варианты из расписания этого зала.
                  </p>
                </div>
                <Button href="/gyms" size="sm">Записать ребёнка</Button>
              </div>

              <div class="mt-6 grid gap-4 md:grid-cols-2">
                {trialRows.slice(0, 4).map((row) => (
                  <div class="rounded-[14px] border border-line bg-neutral-50 p-4">
                    <div class="text-sm font-semibold text-primary">{row.day}</div>
                    <div class="mt-1 text-lg font-bold text-dark">
                      {row.start} - {row.end}
                    </div>
                    <div class="mt-2 text-neutral-700">{row.group}</div>
                    <a href={withBase(`/coaches/${row.coach.id}`)} class="mt-2 inline-flex text-sm font-semibold text-primary hover:underline">
                      {row.coach.data.fullName}
                    </a>
                  </div>
                ))}
              </div>

              {trialCoaches.length > 0 && (
                <div class="mt-6 border-t border-line pt-5">
                  <div class="text-sm font-semibold text-dark">Тренеры, которые ведут эти группы</div>
                  <div class="mt-3 flex flex-wrap gap-2">
                    {trialCoaches.map((coach) => (
                      <a
                        href={withBase(`/coaches/${coach.id}`)}
                        class="rounded-full bg-primary-tint px-3 py-1 text-sm font-medium text-primary hover:bg-primary hover:text-white transition-colors"
                      >
                        {coach.data.fullName}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </section>
          )}

          <section class="rounded-[20px] border border-line bg-white overflow-hidden">
            <div class="p-6 md:p-8 pb-4 md:pb-4">
              <h2 class="text-xl font-extrabold text-dark">Карта и адрес</h2>
            </div>
            <div>
              <div class="aspect-video bg-neutral-100">
                <iframe
                  src={yandexMapWidgetUrl}
                  title={`Карта: ${gym.data.name}`}
                  class="w-full h-full border-0"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen
                />
              </div>
              <div class="flex items-start gap-3 border-t border-line bg-neutral-50 px-6 py-4 text-neutral-800">
                <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
                <p>{gym.data.address}</p>
              </div>
            </div>
          </section>

          {sortedRows.length > 0 && (
            <section class="rounded-[20px] border border-line bg-white overflow-hidden">
              <div class="p-6 md:p-8 pb-4 md:pb-4">
                <h2 class="text-xl font-extrabold text-dark">Расписание</h2>
              </div>
              <div class="overflow-x-auto">
                <table class="w-full min-w-[40rem] text-sm">
                  <thead>
                    <tr class="border-y border-line bg-neutral-50">
                      <th class="sticky left-0 z-20 bg-neutral-50 text-left px-6 py-3 font-semibold text-neutral-700 border-r border-line">День</th>
                      <th class="text-left px-6 py-3 font-semibold text-neutral-700">Время</th>
                      <th class="text-left px-6 py-3 font-semibold text-neutral-700">Группа</th>
                      <th class="text-left px-6 py-3 font-semibold text-neutral-700">Тренер</th>
                    </tr>
                  </thead>
                  <tbody>
                    {[...groupedRows.entries()].map(([day, rows]) =>
                      rows.map((row, index) => (
                        <tr class="border-b border-line-soft">
                          {index === 0 && (
                            <td
                              class="sticky left-0 z-10 bg-primary-tint px-6 py-3 font-semibold text-dark align-middle whitespace-nowrap border-r border-line border-t-2 border-t-primary/20"
                              rowspan={rows.length}
                            >
                              <span class="hidden sm:inline">{day}</span>
                              <span class="sm:hidden">{SHORT_DAY[day] ?? day}</span>
                            </td>
                          )}
                          <td class:list={['px-6 py-3 text-neutral-700 whitespace-nowrap', index === 0 && 'border-t-2 border-t-primary/20']}>
                            {row.start} - {row.end}
                          </td>
                          <td class:list={['px-6 py-3 text-neutral-700', index === 0 && 'border-t-2 border-t-primary/20']}>{row.group}</td>
                          <td class:list={['px-6 py-3 text-neutral-700', index === 0 && 'border-t-2 border-t-primary/20']}>{row.coach.data.fullName}</td>
                        </tr>
                      ))
                    )}
                  </tbody>
                </table>
              </div>
            </section>
          )}
        </div>

        <aside class="min-w-0 rounded-[20px] border border-line bg-white p-6">
          <h2 class="text-lg font-extrabold text-dark">Контакты зала</h2>
          <div class="mt-4 space-y-4">
            <div>
              <div class="text-sm font-semibold text-neutral-600">Адрес</div>
              <p class="mt-1 text-neutral-800">{gym.data.address}</p>
            </div>

            {gym.data.phone && (
              <div>
                <div class="text-sm font-semibold text-neutral-600">Телефон</div>
                <a href={`tel:${gym.data.phone.replace(/[^\d+]/g, '')}`} class="mt-1 inline-block text-primary font-semibold hover:underline">
                  {gym.data.phone}
                </a>
                {gym.data.phoneNote && (
                  <p class="mt-1 text-sm text-neutral-600">{gym.data.phoneNote}</p>
                )}
              </div>
            )}
          </div>

          {gymCoaches.length > 0 && (
            <div class="mt-6 pt-6 border-t border-line">
              <h2 class="text-sm font-semibold text-dark uppercase tracking-wide">Тренеры</h2>
              <div class="mt-3 space-y-2">
                {gymCoaches.map((coach) => (
                  <a href={withBase(`/coaches/${coach.id}`)} class="block text-sm text-neutral-700 hover:text-primary transition-colors">
                    {coach.data.fullName}
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="mt-6 pt-6 border-t border-line">
            <Button href="/gyms" size="sm">Записать ребёнка в этот зал</Button>
          </div>
        </aside>
      </div>

      <div class="mt-10">
        <Button href="/gyms" variant="outline">&larr; Все залы</Button>
      </div>
    </div>
  </article>
</PageLayout>
