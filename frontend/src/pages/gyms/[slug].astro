---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/ui/Button.astro';
import { gyms, scheduleEntries as allScheduleEntries } from '../../data/content';
import { formatTime, withBase } from '../../lib/utils';
import type { Gym, ScheduleEntry } from '../../lib/types';

export async function getStaticPaths() {
  return gyms
    .filter((gym) => gym.slug)
    .map((gym) => ({
      params: { slug: gym.slug },
      props: {
        gym,
        scheduleEntries: allScheduleEntries.filter((entry) => entry.gym?.id === gym.id),
      },
    }));
}

interface Props {
  gym: Gym;
  scheduleEntries: ScheduleEntry[];
}

const { gym, scheduleEntries } = Astro.props;
const dayOrder = ['Понедельник', 'Вторник', 'Среда', 'Четверг', 'Пятница', 'Суббота', 'Воскресенье'];
const sortedEntries = [...scheduleEntries].sort((a, b) => {
  const dayDiff = dayOrder.indexOf(a.dayOfWeek) - dayOrder.indexOf(b.dayOfWeek);

  if (dayDiff !== 0) {
    return dayDiff;
  }

  return a.timeStart.localeCompare(b.timeStart);
});
const groupedEntries = new Map<string, ScheduleEntry[]>();

for (const entry of sortedEntries) {
  const entries = groupedEntries.get(entry.dayOfWeek) ?? [];
  entries.push(entry);
  groupedEntries.set(entry.dayOfWeek, entries);
}

const shortDay: Record<string, string> = {
  'Понедельник': 'Пн',
  'Вторник': 'Вт',
  'Среда': 'Ср',
  'Четверг': 'Чт',
  'Пятница': 'Пт',
  'Суббота': 'Сб',
  'Воскресенье': 'Вс',
};
const pageDescription = gym.description
  ? `${gym.name}: ${gym.address}. ${gym.description}`
  : `${gym.name}: ${gym.address}. Зал Федерации Ашихара-каратэ Краснодарского края.`;
const mapSearchText = `${gym.name}, ${gym.address}`;
const hasCoordinates = typeof gym.latitude === 'number'
  && Number.isFinite(gym.latitude)
  && typeof gym.longitude === 'number'
  && Number.isFinite(gym.longitude);
const yandexMapWidgetUrl = hasCoordinates
  ? `https://yandex.ru/map-widget/v1/?ll=${gym.longitude}%2C${gym.latitude}&mode=search&text=${encodeURIComponent(mapSearchText)}&z=16`
  : `https://yandex.ru/map-widget/v1/?mode=search&text=${encodeURIComponent(mapSearchText)}&z=16`;
---

<PageLayout
  title={gym.name}
  description={pageDescription}
  ogImage={gym.photo ? withBase(gym.photo.url) : undefined}
>
  <article class="py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-4">
      <div class="mb-8">
        <a href={withBase('/gyms')} class="text-sm text-primary hover:underline">&larr; Все залы</a>
      </div>

      <div class="grid gap-8 lg:grid-cols-[1fr_20rem] lg:items-start">
        <div class="min-w-0 space-y-6">
          <section class="rounded-xl border border-neutral-200 bg-white overflow-hidden shadow-sm">
            {gym.photo && (
              <div class="aspect-video bg-neutral-100 overflow-hidden">
                <img
                  src={withBase(gym.photo.url)}
                  alt={gym.name}
                  class="w-full h-full object-cover"
                  loading="eager"
                />
              </div>
            )}

            <div class="p-6 md:p-8">
              <h1 class="text-3xl md:text-4xl font-bold text-dark">{gym.name}</h1>
              <div class="mt-4 flex items-start gap-3 text-neutral-700">
                <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
                <p>{gym.address}</p>
              </div>

              {gym.description && (
                <p class="mt-5 text-neutral-700 leading-relaxed">{gym.description}</p>
              )}
            </div>
          </section>

          <section class="rounded-xl border border-neutral-200 bg-white overflow-hidden shadow-sm">
            <div class="p-6 md:p-8 pb-4 md:pb-4">
              <h2 class="text-xl font-bold text-dark">Карта и адрес</h2>
            </div>
            {gym.yandexMapEmbed ? (
              <div class="aspect-video bg-neutral-100" set:html={gym.yandexMapEmbed} />
            ) : (
              <div>
                <div class="aspect-video bg-neutral-100">
                  <iframe
                    src={yandexMapWidgetUrl}
                    title={`Карта: ${gym.name}`}
                    class="w-full h-full border-0"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen
                  />
                </div>
                <div class="flex items-start gap-3 border-t border-neutral-200 bg-neutral-50 px-6 py-4 text-neutral-800">
                  <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                  </svg>
                  <p>{gym.address}</p>
                </div>
              </div>
            )}
          </section>

          {sortedEntries.length > 0 && (
            <section class="rounded-xl border border-neutral-200 bg-white overflow-hidden shadow-sm">
              <div class="p-6 md:p-8 pb-4 md:pb-4">
                <h2 class="text-xl font-bold text-dark">Расписание</h2>
              </div>
              <div class="overflow-x-auto">
                <table class="w-full min-w-[40rem] text-sm">
                  <thead>
                    <tr class="border-y border-neutral-200 bg-neutral-50">
                      <th class="sticky left-0 z-20 bg-neutral-50 text-left px-6 py-3 font-semibold text-neutral-700 border-r border-neutral-200">День</th>
                      <th class="text-left px-6 py-3 font-semibold text-neutral-700">Время</th>
                      <th class="text-left px-6 py-3 font-semibold text-neutral-700">Группа</th>
                      <th class="text-left px-6 py-3 font-semibold text-neutral-700">Тренер</th>
                    </tr>
                  </thead>
                  <tbody>
                    {[...groupedEntries.entries()].map(([day, entries]) =>
                      entries.map((entry, index) => (
                        <tr class="border-b border-neutral-100">
                          {index === 0 && (
                            <td
                              class="sticky left-0 z-10 bg-primary/5 px-6 py-3 font-semibold text-dark align-middle whitespace-nowrap border-r border-neutral-200 border-t-2 border-t-primary/20"
                              rowspan={entries.length}
                            >
                              <span class="hidden sm:inline">{day}</span>
                              <span class="sm:hidden">{shortDay[day] ?? day}</span>
                            </td>
                          )}
                          <td class:list={['px-6 py-3 text-neutral-700 whitespace-nowrap', index === 0 && 'border-t-2 border-t-primary/20']}>
                            {formatTime(entry.timeStart)} - {formatTime(entry.timeEnd)}
                          </td>
                          <td class:list={['px-6 py-3 text-neutral-700', index === 0 && 'border-t-2 border-t-primary/20']}>{entry.groupName}</td>
                          <td class:list={['px-6 py-3 text-neutral-700', index === 0 && 'border-t-2 border-t-primary/20']}>{entry.coach?.fullName || '-'}</td>
                        </tr>
                      ))
                    )}
                  </tbody>
                </table>
              </div>
            </section>
          )}
        </div>

        <aside class="min-w-0 rounded-xl border border-neutral-200 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-bold text-dark">Контакты зала</h2>
          <div class="mt-4 space-y-4">
            <div>
              <div class="text-sm font-semibold text-neutral-600">Адрес</div>
              <p class="mt-1 text-neutral-800">{gym.address}</p>
            </div>

            {gym.phone && (
              <div>
                <div class="text-sm font-semibold text-neutral-600">Телефон</div>
                <a href={`tel:${gym.phone.replace(/[^\d+]/g, '')}`} class="mt-1 inline-block text-primary font-semibold hover:underline">
                  {gym.phone}
                </a>
              </div>
            )}
          </div>

          {gym.coaches && gym.coaches.length > 0 && (
            <div class="mt-6 pt-6 border-t border-neutral-200">
              <h2 class="text-sm font-semibold text-dark uppercase tracking-wide">Тренеры</h2>
              <div class="mt-3 space-y-2">
                {gym.coaches.map((coach) => (
                  coach.slug ? (
                    <a href={withBase(`/coaches/${coach.slug}`)} class="block text-sm text-neutral-700 hover:text-primary transition-colors">
                      {coach.fullName}
                    </a>
                  ) : (
                    <div class="text-sm text-neutral-700">{coach.fullName}</div>
                  )
                ))}
              </div>
            </div>
          )}

          <div class="mt-6 pt-6 border-t border-neutral-200">
            <Button href="/contacts" size="sm">Записаться</Button>
          </div>
        </aside>
      </div>

      <div class="mt-10">
        <Button href="/gyms" variant="outline">&larr; Все залы</Button>
      </div>
    </div>
  </article>
</PageLayout>
