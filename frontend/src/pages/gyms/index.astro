---
import { getCollection, getEntries } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import { equipmentStages } from '../../data/marketing';
import { withBase } from '../../lib/utils';

const gyms = (await getCollection('gyms')).sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const gymsFull = await Promise.all(
  gyms.map(async (gym) => {
    const coaches = await getEntries(gym.data.coaches);

    return {
      gym,
      coachNames: coaches.map((coach) => `${coach.data.fullName} (${coach.data.rank})`).join(', '),
      tel: gym.data.phone ? `tel:${gym.data.phone.replace(/[^+\d]/g, '')}` : undefined,
    };
  }),
);

const safetyNote =
  'Перед каждой тренировкой: ногти коротко подстрижены, длинные волосы собраны, украшения и часы сняты. Это требование безопасности — и для вашего ребёнка, и для его партнёров.';
---

<PageLayout
  title="Залы и запись на пробное"
  description="Залы Федерации Ашихара-каратэ в Краснодаре: адреса, тренеры, телефоны для записи на пробное занятие."
>
  <section class="max-w-[1180px] mx-auto px-[22px] py-[clamp(36px,5vw,60px)]">
    <h1 class="mb-[10px] font-black text-[clamp(30px,4.2vw,46px)] tracking-[-0.025em]">Залы и запись на пробное</h1>
    <p class="mb-8 max-w-[620px] text-base text-neutral-800 leading-[1.6] text-pretty">
      Выберите зал ближе к дому и позвоните — тренер или администратор подберёт группу и время пробного занятия.
    </p>

    <div class="flex flex-col gap-5">
      {gymsFull.map(({ gym, coachNames, tel }) => (
        <div class="bg-white border border-line rounded-[24px] overflow-hidden grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))]">
          {gym.data.photo ? (
            <Image
              src={gym.data.photo}
              alt={gym.data.photoAlt ?? gym.data.name}
              width={1200}
              height={800}
              class="h-full w-full min-h-[240px] object-cover"
            />
          ) : (
            <div class="min-h-[240px] bg-cream-dark" role="img" aria-label={gym.data.name}></div>
          )}
          <div class="p-[clamp(22px,3vw,34px)]">
            <div class="mb-[6px] text-[13px] font-bold text-primary">{gym.data.district}</div>
            <div class="mb-[6px] font-extrabold text-[clamp(22px,2.6vw,27px)] tracking-[-0.015em]">
              <a href={withBase(`/gyms/${gym.id}`)} class="hover:text-primary transition-colors">{gym.data.name}</a>
            </div>
            <div class="mb-3 text-[15px] font-semibold">{gym.data.address}</div>
            {coachNames && (
              <div class="mb-[18px] text-[13.5px] text-neutral-600 leading-[1.55]">Тренирует: {coachNames}</div>
            )}
            {gym.data.phone && (
              <div class="flex items-center gap-3.5 flex-wrap">
                <a
                  href={tel}
                  class="inline-block bg-dark text-white rounded-full font-bold text-[15px] px-[22px] py-3 hover:bg-primary transition-colors"
                >
                  {gym.data.phone}
                </a>
                {gym.data.phoneNote && <span class="text-[13px] text-neutral-600">{gym.data.phoneNote}</span>}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-[clamp(44px,6vw,72px)]">
      <h2 class="mb-2 font-extrabold text-[clamp(22px,2.8vw,30px)] tracking-[-0.02em]">Что взять с собой</h2>
      <p class="mb-[22px] text-[15px] text-neutral-600">На пробное занятие покупать ничего не нужно.</p>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-4">
        {equipmentStages.map((stage) => (
          <div class="bg-white border border-line rounded-[20px] px-6 py-[22px] flex flex-col gap-[9px]">
            <div class="mb-1 font-extrabold text-base">{stage.title}</div>
            {stage.items.map((item) => (
              <div class="flex gap-2.5 text-sm leading-[1.5] text-dark-surface">
                <span class="text-primary font-extrabold">&middot;</span>{item}
              </div>
            ))}
            <div class="mt-auto pt-2.5 border-t border-line-soft text-[13px] text-neutral-600 leading-[1.55]">
              {stage.note}
            </div>
          </div>
        ))}
      </div>
      <p class="mt-[18px] max-w-[700px] text-[13px] text-neutral-600 leading-[1.6]">{safetyNote}</p>
    </div>
  </section>
</PageLayout>
