---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import EventRow from '../components/events/EventRow.astro';
import { firstMonthSteps, parentQuestions } from '../data/marketing';
import { withBase } from '../lib/utils';
import nikoLogo from '../assets/niko-logo.png';

const gyms = (await getCollection('gyms')).sort((a, b) => a.data.sortOrder - b.data.sortOrder);
const coaches = (await getCollection('coaches')).sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const allEvents = (await getCollection('events'))
  .sort((a, b) => a.data.eventDate.valueOf() - b.data.eventDate.valueOf());

const today = new Date();
today.setHours(0, 0, 0, 0);

// Ближайшие будущие - по возрастанию даты; если их нет - недавние прошедшие по убыванию
const upcoming = allEvents.filter((e) => e.data.eventDate >= today).slice(0, 3);
const recent = allEvents.filter((e) => e.data.eventDate < today).reverse().slice(0, 3);
const homeEvents = upcoming.length > 0 ? upcoming : recent;
const eventsHeading = upcoming.length > 0 ? 'Ближайшие события' : 'Недавние события';

// Имя без отчества для плитки тренера
function shortName(fullName: string): string {
  const parts = fullName.split(' ');
  return parts.length >= 2 ? `${parts[0]} ${parts[1]}` : fullName;
}
---

<PageLayout
  title="Главная"
  description="Федерация Ашихара-каратэ Краснодарского края: залы, тренеры, программа поясов от 10 кю до данов, соревнования и аттестации. Член международной организации NIKO."
>
  <section class="mx-auto grid max-w-[1180px] grid-cols-[repeat(auto-fit,minmax(320px,1fr))] items-center gap-[clamp(28px,4.5vw,64px)] px-[22px] pt-[clamp(40px,6vw,80px)] pb-[clamp(36px,5vw,64px)]">
    <div>
      <div class="mb-[22px] inline-flex flex-wrap items-center gap-[10px] text-[13.5px] font-bold uppercase tracking-[0.06em] text-neutral-600">
        Член международной организации NIKO
        <span class="h-[4px] w-[4px] shrink-0 rounded-full bg-primary"></span>
        Ашихара кайкан
      </div>
      <h1 class="mb-5 text-[clamp(34px,4.6vw,56px)] font-black leading-[1.05] tracking-[-0.028em] [text-wrap:pretty]">Федерация Ашихара-каратэ Краснодарского края</h1>
      <p class="mb-7 max-w-[500px] text-[clamp(15px,1.7vw,17px)] leading-[1.65] text-neutral-800 [text-wrap:pretty]">Официально развиваем стиль в регионе: шесть залов, аттестованные тренеры, программа поясов от 10 кю до данов, соревнования — от городских турниров до чемпионатов мира.</p>
      <div class="flex flex-wrap items-center gap-3">
        <a href={withBase('/gyms')} class="rounded-full bg-primary px-[30px] py-[15px] text-[16px] font-bold text-white shadow-[0_10px_24px_rgba(185,33,54,0.3)] transition-colors hover:bg-primary-dark">Выбрать зал рядом</a>
        <a href={withBase('/education')} class="rounded-full border-[1.5px] border-[#D9D7CE] bg-white px-[28px] py-[13.5px] text-[16px] font-bold text-dark transition-colors hover:border-dark">Программа поясов</a>
      </div>
      <div class="mt-[38px] flex max-w-[480px] items-center gap-3">
        <span class="h-[2px] w-[30px] shrink-0 bg-primary"></span>
        <div class="text-[15.5px] font-semibold leading-[1.5] text-dark-surface">Тренируем с 1996 года — за плечами три десятилетия опыта и поколения воспитанных спортсменов.</div>
      </div>
    </div>
    <div class="flex aspect-[5/4] flex-col items-center justify-center gap-[18px] rounded-[24px] bg-dark p-7 shadow-[0_24px_60px_rgba(27,27,34,0.2)]">
      <Image src={nikoLogo} alt="Логотип федерации" width={420} class="block h-[clamp(150px,17vw,210px)] w-[clamp(150px,17vw,210px)] rounded-full object-contain" />
      <div class="text-center">
        <div class="mb-[6px] text-[19px] font-bold tracking-[0.32em] text-white">芦原会館</div>
        <div class="text-[12.5px] font-semibold uppercase tracking-[0.14em] text-[#8A8A94]">Ашихара кайкан · New International Karate Organization</div>
      </div>
    </div>
  </section>

  <section class="mt-[clamp(28px,4vw,48px)] bg-dark">
    <div class="mx-auto max-w-[1180px] px-[22px] py-[clamp(44px,6vw,76px)]">
      <div class="mb-[14px] text-[13.5px] font-bold uppercase tracking-[0.06em] text-[#8A8A94]">О стиле</div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] items-start gap-[clamp(24px,4vw,56px)]">
        <div>
          <h2 class="mb-4 text-[clamp(24px,3vw,34px)] font-extrabold tracking-[-0.02em] text-white [text-wrap:pretty]">Что такое Ашихара-каратэ</h2>
          <p class="mb-[14px] text-[15px] leading-[1.7] text-[#B9B9C0] [text-wrap:pretty]">Контактный стиль каратэ, основанный японским мастером Хидэюки Ашихарой в сентябре 1980 года. Международная организация — Ашихара кайкан (New International Karatedo Federation, NIKO): около 180 отделений в Японии и около 220 по всему миру. Сегодня её возглавляет сын основателя, Хидэнори Ашихара.</p>
          <p class="text-[15px] leading-[1.7] text-[#B9B9C0] [text-wrap:pretty]">Обучение строится от базовой техники (кихон) через собственную систему ката к поединкам (кумитэ) — и подчинено одному принципу: двигаться так, чтобы бить и не быть сбитым.</p>
        </div>
        <div class="flex flex-col gap-3">
          <div class="rounded-[18px] border border-white/10 bg-white/5 px-[22px] py-5">
            <div class="mb-[6px] text-[16px] font-extrabold text-white">Сабаки — главный принцип</div>
            <div class="text-[14px] leading-[1.6] text-[#B9B9C0]">В привычном каратэ побеждает тот, кто перебил соперника. Философия Ашихары другая: побеждает тот, кто тренируется рациональнее — уходит с линии атаки в «слепую зону» противника и мгновенно отвечает.</div>
          </div>
          <div class="rounded-[18px] border border-white/10 bg-white/5 px-[22px] py-5">
            <div class="mb-[6px] text-[16px] font-extrabold text-white">Каратэ для каждого</div>
            <div class="text-[14px] leading-[1.6] text-[#B9B9C0]">Тема Ашихара кайкан — каратэ, которым каждый может заниматься спокойно и с удовольствием. Система ката построена по уровням: сабаки отрабатывается от новичка до мастера.</div>
          </div>
          <div class="rounded-[18px] border border-white/10 bg-white/5 px-[22px] py-5">
            <div class="mb-[6px] text-[16px] font-extrabold text-white">Сила и характер</div>
            <div class="text-[14px] leading-[1.6] text-[#B9B9C0]">Девиз школы: без внутренней силы не бывает настоящей доброты и заботы о людях. Цель — каратэ, которое пригодится в обычной жизни, а не только на татами.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1180px] px-[22px] pt-[clamp(40px,6vw,72px)]">
    <div class="mb-[22px] flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="text-[clamp(24px,3vw,32px)] font-extrabold tracking-[-0.02em]">Залы федерации</h2>
      <a href={withBase('/gyms')} class="text-[14.5px] font-bold text-primary hover:text-primary-deep">Все залы и телефоны →</a>
    </div>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-[18px]">
      {gyms.map((gym) => (
        <a
          href={withBase('/gyms')}
          class="overflow-hidden rounded-[20px] border border-line bg-white text-dark transition-[box-shadow,transform] duration-[180ms] ease-out hover:-translate-y-[2px] hover:shadow-[0_14px_34px_rgba(27,27,34,0.1)]"
        >
          {gym.data.photo ? (
            <Image src={gym.data.photo} alt={gym.data.photoAlt ?? gym.data.name} width={640} class="h-[170px] w-full object-cover" />
          ) : (
            <div class="h-[170px] w-full bg-cream-dark"></div>
          )}
          <div class="px-[18px] pt-4 pb-[18px]">
            <div class="mb-[5px] text-[12.5px] font-bold text-primary">{gym.data.district}</div>
            <div class="text-[18px] font-extrabold tracking-[-0.01em]">{gym.data.name}</div>
            <div class="mt-1 text-[13.5px] leading-[1.45] text-neutral-600">{gym.data.address}</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-[1180px] px-[22px] pt-[clamp(40px,6vw,72px)]">
    <div class="mb-[22px] flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="text-[clamp(24px,3vw,32px)] font-extrabold tracking-[-0.02em]">{eventsHeading}</h2>
      <a href={withBase('/events')} class="text-[14.5px] font-bold text-primary hover:text-primary-deep">Все события →</a>
    </div>
    <div class="overflow-hidden rounded-[20px] border border-line bg-white">
      {homeEvents.map((event) => <EventRow event={event} />)}
    </div>
  </section>

  <section class="mx-auto max-w-[1180px] px-[22px] pt-[clamp(40px,6vw,72px)]">
    <div class="mb-[22px] flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="text-[clamp(24px,3vw,32px)] font-extrabold tracking-[-0.02em]">Тренеры</h2>
      <a href={withBase('/coaches')} class="text-[14.5px] font-bold text-primary hover:text-primary-deep">Подробнее о тренерах →</a>
    </div>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(190px,1fr))] gap-[18px]">
      {coaches.map((coach) => (
        <a
          href={withBase('/coaches')}
          class="overflow-hidden rounded-[20px] border border-line bg-white text-dark transition-[box-shadow,transform] duration-[180ms] ease-out hover:-translate-y-[2px] hover:shadow-[0_14px_34px_rgba(27,27,34,0.1)]"
        >
          {coach.data.photo ? (
            <Image src={coach.data.photo} alt={coach.data.fullName} width={480} class="aspect-[2/3] w-full object-cover" />
          ) : (
            <div class="aspect-[2/3] w-full bg-cream-dark"></div>
          )}
          <div class="px-4 pt-[13px] pb-[15px]">
            <div class="text-[14.5px] font-bold leading-[1.3]">{shortName(coach.data.fullName)}</div>
            <div class="mt-[3px] text-[13px] font-bold text-primary">{coach.data.rank}</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-[1180px] px-[22px] pt-[clamp(40px,6vw,72px)]">
    <h2 class="mb-2 text-[clamp(24px,3vw,32px)] font-extrabold tracking-[-0.02em]">Первый месяц занятий</h2>
    <p class="mb-6 max-w-[540px] text-[15px] text-neutral-600">Что ребёнок успеет за первые недели — без спешки и лишних ожиданий.</p>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-[14px]">
      {firstMonthSteps.map((step, index) => (
        <div class="flex items-start gap-4 rounded-[18px] border border-line bg-white px-[22px] py-5">
          <div class="flex h-[34px] w-[34px] shrink-0 items-center justify-center rounded-full bg-primary-tint text-[15px] font-extrabold text-primary">{index + 1}</div>
          <div>
            <div class="mb-1 text-[15px] font-bold">{step.title}</div>
            <div class="text-[13.5px] leading-[1.5] text-neutral-600">{step.description}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-[820px] px-[22px] py-[clamp(40px,6vw,72px)]">
    <h2 class="mb-6 text-center text-[clamp(24px,3vw,32px)] font-extrabold tracking-[-0.02em]">Вопросы родителей</h2>
    <div class="rounded-[20px] border border-line bg-white px-6 py-[6px]">
      {parentQuestions.map((question) => (
        <details class="group border-b border-line-soft last:border-b-0">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-[17px] text-[15px] font-bold [&::-webkit-details-marker]:hidden">
            {question.title}
            <span class="shrink-0 text-[22px] font-normal leading-none text-primary transition-transform duration-[180ms] group-open:rotate-45">+</span>
          </summary>
          <p class="max-w-[620px] pb-[18px] text-[14px] leading-[1.65] text-neutral-800">{question.text}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-[1180px] px-[22px] pb-[clamp(48px,7vw,84px)]">
    <div class="flex flex-wrap items-center gap-7 rounded-[28px] bg-[linear-gradient(135deg,var(--color-primary),var(--color-primary-deep))] p-[clamp(32px,5vw,56px)] shadow-[0_24px_60px_rgba(185,33,54,0.25)]">
      <div class="min-w-[260px] flex-1">
        <div class="text-[clamp(24px,3.4vw,38px)] font-black leading-[1.15] tracking-[-0.02em] text-white">Первое занятие — пробное</div>
        <div class="mt-[10px] max-w-[500px] text-[15px] leading-[1.6] text-white/80">Ребёнок увидит зал, тренера и группу до того, как вы что-то оплачиваете и покупаете форму.</div>
      </div>
      <a href={withBase('/gyms')} class="rounded-full bg-white px-8 py-[15px] text-[16px] font-extrabold text-primary shadow-[0_10px_24px_rgba(0,0,0,0.18)] transition-colors hover:bg-cream">Выбрать зал</a>
    </div>
  </section>
</PageLayout>
