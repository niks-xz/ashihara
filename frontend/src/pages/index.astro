---
import { getCollection, type CollectionEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import UpcomingEvents from '../components/home/UpcomingEvents.astro';
import AboutPreview from '../components/home/AboutPreview.astro';
import CtaSection from '../components/home/CtaSection.astro';

const allEvents = (await getCollection('events'))
  .sort((a, b) => a.data.eventDate.valueOf() - b.data.eventDate.valueOf());

const today = new Date();
today.setHours(0, 0, 0, 0);

const events: CollectionEntry<'events'>[] = [];
let latestArchiveYear: number | undefined;

for (const event of allEvents) {
  const eventYear = event.data.eventDate.getFullYear();

  if (latestArchiveYear === undefined || eventYear > latestArchiveYear) {
    latestArchiveYear = eventYear;
  }

  if (event.data.eventDate >= today && events.length < 3) {
    events.push(event);
  }
}
---

<PageLayout
  title="Главная"
  description="Федерация Ашихара-каратэ г. Краснодара. Тренировки для детей и взрослых, соревнования, аттестации. Организация NIKO."
>
  <HeroSection />
  <UpcomingEvents
    events={events}
    archiveEventCount={allEvents.length}
    latestArchiveYear={latestArchiveYear}
  />
  <AboutPreview />
  <CtaSection />
</PageLayout>
