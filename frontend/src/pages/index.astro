---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import UpcomingEvents from '../components/home/UpcomingEvents.astro';
import AboutPreview from '../components/home/AboutPreview.astro';
import CtaSection from '../components/home/CtaSection.astro';

const allEvents = (await getCollection('events'))
  .sort((a, b) => a.data.eventDate.valueOf() - b.data.eventDate.valueOf());

const today = new Date();
today.setHours(0, 0, 0, 0);

// Ближайшие будущие - по возрастанию даты, недавние прошедшие - по убыванию
const upcoming = allEvents.filter((e) => e.data.eventDate >= today).slice(0, 3);
const recent = allEvents.filter((e) => e.data.eventDate < today).reverse().slice(0, 3);
---

<PageLayout
  title="Главная"
  description="Федерация Ашихара-каратэ г. Краснодара. Тренировки для детей и взрослых, соревнования, аттестации. Организация NIKO."
>
  <HeroSection />
  <UpcomingEvents upcoming={upcoming} recent={recent} />
  <AboutPreview />
  <CtaSection />
</PageLayout>
