---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/ui/Button.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { gymMarketingBySlug, parentQuestions } from '../data/marketing';
import { getGymSchedule, isYouthRow, uniqueCoaches } from '../lib/schedule';
import { withBase } from '../lib/utils';

const sortedGyms = (await getCollection('gyms')).sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const gymCards = await Promise.all(sortedGyms.map(async (gym) => {
  const rows = await getGymSchedule(gym.id);
  const youthRows = rows.filter(isYouthRow);
  const visibleRows = youthRows.length > 0 ? youthRows : rows;

  return {
    gym,
    marketing: gymMarketingBySlug[gym.id],
    rows: visibleRows.slice(0, 3),
    coaches: uniqueCoaches(visibleRows),
  };
}));

const firstSteps = [
  'Выберите зал, который удобно посещать регулярно',
  'Свяжитесь с федерацией и уточните подходящую группу',
  'Приходите на пробное занятие за 10-15 минут до начала',
  'После занятия обсудите с тренером форму, график и следующий шаг',
];
---

<PageLayout
  title="Ашихара-каратэ для детей"
  description="Ашихара-каратэ для детей в Краснодаре: с какого возраста начать, как проходят тренировки, где находятся залы и как записаться на пробное занятие."
>
  <section class="bg-dark text-white">
    <div class="max-w-7xl mx-auto px-4 py-16 md:py-24">
      <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
        <div>
          <div class="inline-flex items-center rounded-full border border-primary/30 bg-primary/10 px-4 py-1.5 text-sm font-medium text-primary-light">
            Детские группы в Краснодаре
          </div>
          <h1 class="mt-6 text-4xl md:text-5xl font-bold leading-tight">
            Ашихара-каратэ для детей в Краснодаре
          </h1>
          <p class="mt-5 max-w-2xl text-lg text-neutral-300">
            Помогаем ребёнку развивать дисциплину, координацию, уверенность и уважение к партнёрам через понятную систему тренировок и постепенный рост.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <Button href="/gyms" size="lg">Выбрать зал</Button>
            <Button href="/contacts" variant="light-outline" size="lg">Записать ребёнка</Button>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-1 gap-4">
          <div class="rounded-lg border border-white/10 bg-white/8 p-5">
            <div class="text-3xl font-bold text-primary-light">5+</div>
            <p class="mt-2 text-sm text-neutral-300">ориентир по возрасту для первого знакомства с тренировками</p>
          </div>
          <div class="rounded-lg border border-white/10 bg-white/8 p-5">
            <div class="text-3xl font-bold text-primary-light">2 раза</div>
            <p class="mt-2 text-sm text-neutral-300">в неделю обычно достаточно для спокойного старта</p>
          </div>
          <div class="rounded-lg border border-white/10 bg-white/8 p-5">
            <div class="text-3xl font-bold text-primary-light">1 визит</div>
            <p class="mt-2 text-sm text-neutral-300">достаточно для первого знакомства с группой</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <SectionHeading
        title="Что важно родителям"
        subtitle="Короткие ответы на вопросы, которые обычно возникают перед первой тренировкой"
      />
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {parentQuestions.map((item) => (
          <article class="rounded-lg border border-neutral-200 bg-neutral-50 p-6">
            <h3 class="text-lg font-bold text-dark">{item.title}</h3>
            <p class="mt-3 text-neutral-700 leading-relaxed">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
        <div>
          <SectionHeading
            title="Как проходит старт"
            subtitle="Первый месяц нужен не для результата любой ценой, а для спокойного входа в режим тренировок"
            centered={false}
          />
          <Button href="/student-path" variant="outline">Открыть путь ученика</Button>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {firstSteps.map((step, index) => (
            <div class="rounded-lg border border-neutral-200 bg-white p-5 shadow-sm">
              <div class="flex items-center gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary text-white font-bold">
                  {index + 1}
                </span>
                <h3 class="font-bold text-dark">{step}</h3>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <SectionHeading
        title="Выберите удобный зал"
        subtitle="Для ребёнка особенно важно, чтобы дорога до тренировок была регулярной и понятной"
      />
      <div class="grid gap-6 lg:grid-cols-3">
        {gymCards.map(({ gym, marketing, rows, coaches }) => (
          <article class="flex flex-col rounded-lg border border-neutral-200 bg-white p-6 shadow-sm">
            <h3 class="text-xl font-bold text-dark">{gym.data.name}</h3>
            <p class="mt-2 text-sm text-neutral-600">{gym.data.address}</p>

            {marketing && (
              <p class="mt-4 text-neutral-700 leading-relaxed">{marketing.audience}</p>
            )}

            {rows.length > 0 && (
              <div class="mt-5 rounded-lg bg-neutral-50 p-4">
                <div class="text-sm font-semibold text-dark">Ближайшие группы по расписанию</div>
                <ul class="mt-3 space-y-2 text-sm text-neutral-700">
                  {rows.map((row) => (
                    <li class="flex justify-between gap-4">
                      <span>{row.day}, {row.group}</span>
                      <span class="font-medium text-dark whitespace-nowrap">{row.start}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {coaches.length > 0 && (
              <div class="mt-5">
                <div class="text-sm font-semibold text-dark">Тренеры в расписании</div>
                <div class="mt-2 flex flex-wrap gap-2">
                  {coaches.map((coach) => (
                    <a
                      href={withBase(`/coaches/${coach.id}`)}
                      class="rounded-md bg-primary/10 px-3 py-1 text-sm font-medium text-primary hover:bg-primary hover:text-white transition-colors"
                    >
                      {coach.data.fullName}
                    </a>
                  ))}
                </div>
              </div>
            )}

            <div class="mt-auto pt-6 flex flex-col gap-3">
              <Button href={`/gyms/${gym.id}`} variant="outline" size="sm">Подробнее о зале</Button>
              <Button href={`/contacts?gym=${gym.id}`} size="sm">Записать ребёнка в этот зал</Button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white">Ребёнку проще начать, когда путь понятен</h2>
      <p class="mt-4 text-lg text-white/85">
        Посмотрите, как устроены первые шаги ученика: чек-лист первого месяца, термины и путь по поясам.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
        <Button href="/student-path" variant="secondary" size="lg">Путь ученика</Button>
        <Button href="/contacts" variant="light-outline" size="lg">Записаться на пробное</Button>
      </div>
    </div>
  </section>
</PageLayout>
