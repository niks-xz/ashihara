---
import { getCollection, type CollectionEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import RequirementsTable from '../../components/methodology/RequirementsTable.astro';
import KataVideoGrid from '../../components/methodology/KataVideoGrid.astro';
import BeltVisual from '../../components/methodology/BeltVisual.astro';
import { getBeltDescription } from '../../lib/belts';
import { withBase } from '../../lib/utils';

export async function getStaticPaths() {
  const [belts, allVideos] = await Promise.all([
    getCollection('belts'),
    getCollection('kata-videos'),
  ]);

  return belts.map((belt) => ({
    params: { slug: belt.id },
    props: {
      belt,
      videos: allVideos
        .filter((video) => video.data.belt?.id === belt.id)
        .sort((a, b) => a.data.sortOrder - b.data.sortOrder),
    },
  }));
}

interface Props {
  belt: CollectionEntry<'belts'>;
  videos: CollectionEntry<'kata-videos'>[];
}

const { belt, videos } = Astro.props;
const beltDescription = getBeltDescription(belt);

const sections = [
  { title: 'Силовые тесты', rows: belt.data.strengthTests },
  { title: 'Кихон', rows: belt.data.kihon },
  { title: 'Идо кихон', rows: belt.data.idoKihon },
  { title: 'Ката', rows: belt.data.kata },
  { title: 'Кумитэ', rows: belt.data.kumite },
  { title: 'Сабаки', rows: belt.data.sabaki },
  { title: 'Тамэши вари', rows: belt.data.tameshiWari },
];
---

<PageLayout
  title={`${belt.data.name} — Экзаменационные требования`}
  description={`Экзаменационные требования для ${belt.data.name} (${belt.data.beltColor} пояс) по Ашихара-каратэ. Кихон, ката, кумитэ, сабаки.`}
>
  <section class="py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4">
      <div class="mb-8">
        <a href={withBase('/methodology')} class="text-sm text-primary hover:underline">&larr; Все уровни</a>
      </div>

      <div class="flex items-center gap-4 mb-8">
        <BeltVisual belt={belt} class="w-24 h-9" stripeClass="w-[5px]" />
        <div>
          <h1 class="text-3xl font-bold text-dark">{belt.data.name}</h1>
          <p class="text-neutral-600">{beltDescription}</p>
        </div>
      </div>

      {belt.data.description && (
        <p class="text-neutral-600 mb-8">{belt.data.description}</p>
      )}

      {sections.map(({ title, rows }) => (
        <RequirementsTable title={title} rows={rows} />
      ))}

      <KataVideoGrid videos={videos} />

      <div class="mt-12 pt-8 border-t border-neutral-200">
        <a href={withBase('/methodology')} class="text-primary hover:underline font-medium">&larr; Все уровни</a>
      </div>
    </div>
  </section>
</PageLayout>
