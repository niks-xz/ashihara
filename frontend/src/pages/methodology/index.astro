---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import BeltLevelCard from '../../components/methodology/BeltLevelCard.astro';
import Button from '../../components/ui/Button.astro';
import { withBase } from '../../lib/utils';

const beltLevels = (await getCollection('belts')).sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<PageLayout
  title="Методичка"
  description="Экзаменационные требования Ашихара-каратэ от 10 кю (белый пояс) до 3 дана (чёрный пояс). Кихон, ката, кумитэ, сабаки."
>
  <section class="py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4">
      <SectionHeading
        title="Экзаменационные требования"
        subtitle="Выберите уровень для просмотра требований к аттестации"
      />

      <div class="mb-8 rounded-lg border border-primary/20 bg-primary/5 p-5">
        <h2 class="text-lg font-bold text-dark">Для самостоятельного повторения</h2>
        <p class="mt-2 text-neutral-700">
          Откройте путь ученика: чек-лист первого месяца, термины, базовые последовательности и мини-квизы по требованиям.
        </p>
        <div class="mt-4">
          <Button href="/student-path" size="sm">Путь ученика</Button>
        </div>
      </div>

      {beltLevels.length > 0 ? (
        <div class="space-y-3">
          {beltLevels.map((belt) => <BeltLevelCard belt={belt} />)}
        </div>
      ) : (
        <p class="text-center text-neutral-600">Экзаменационные требования скоро появятся</p>
      )}

      <div class="mt-8 flex items-center justify-between gap-4 rounded-lg border border-neutral-200 bg-white p-5">
        <div>
          <div class="font-semibold text-dark">Экзаменационные требования одним файлом</div>
          <p class="mt-1 text-sm text-neutral-600">Официальный PDF федерации, редакция июня 2025 года.</p>
        </div>
        <a
          href={withBase('/files/ekzamenaczionnye-trebovaniya.pdf')}
          class="inline-flex shrink-0 items-center gap-2 rounded-lg border-2 border-primary px-4 py-2 text-sm font-semibold text-primary transition-colors hover:bg-primary hover:text-white"
          download
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
          </svg>
          Скачать PDF
        </a>
      </div>
    </div>
  </section>
</PageLayout>
